# Copy this file to .env and fill in real values. Never commit the real .env.
# See README.md "Secrets" section for where to obtain/generate each one.

# --- General ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
PORT=3000

# --- Postgres ---
# Superuser credentials used ONLY by scripts/bootstrap-db.sql (one-time, per
# environment) to create the two application roles below. Not used at runtime.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
POSTGRES_DB=goto5x

# Application roles created by bootstrap-db.sql. Generate real passwords with
# e.g. `openssl rand -base64 32` per environment - never reuse the placeholder.
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=change-me-local-only
POSTGRES_ADMIN_USER=app_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-only

# Full connection strings the app actually uses (must match the roles above).
DATABASE_URL=postgresql://app_runtime:change-me-local-only@localhost:5432/goto5x?schema=public
DATABASE_ADMIN_URL=postgresql://app_admin:change-me-local-only@localhost:5432/goto5x?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with e.g. `openssl rand -hex 32`. Rotating this invalidates every
# active session.
JWT_ACCESS_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# TOTP issuer name shown in admins' authenticator apps during MFA enrollment.
ADMIN_MFA_ISSUER_NAME=goto5x.com

# --- Object storage (MinIO) ---
MINIO_ROOT_USER=goto5x-minio
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_ENDPOINT=http://localhost:9000
# Bucket the app writes media into (create it once per environment - Module 2
# does not auto-create it, to avoid a surprise implicit-infra side effect).
MINIO_BUCKET=goto5x-media
# Optional: the CDN-fronted public base URL media is served from (SRS §3.3).
# Leave unset in local dev to fall back to MINIO_ENDPOINT/MINIO_BUCKET directly.
MEDIA_PUBLIC_BASE_URL=

# --- Google Drive import (FR-9.1) ---
# From a Google Cloud OAuth 2.0 Client ID (Drive API scope, read-only).
GOOGLE_DRIVE_CLIENT_ID=change-me
GOOGLE_DRIVE_CLIENT_SECRET=change-me
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/media/drive/callback
# AES-256-GCM key encrypting a seller's stored refresh token at rest - generate
# with `openssl rand -base64 32`. The short-lived access token is never
# persisted to Postgres at all (Redis only, see docs/SRS.md §6.5) so there is
# no equivalent key needed for it.
DRIVE_TOKEN_ENCRYPTION_KEY=change-me-generate-a-real-32-byte-key

# --- Suppliers & Printify Adapter (Module 8, FR-4.1) ---
# From a Printify Personal Access Token (Printify account settings -> Connections).
# v1.0 uses one platform-level Printify API credential (see docs/build-plan.md's
# Module 8 section for why); per-supplier shop selection is `suppliers.printify_shop_id`
# on that supplier's own record, set via the admin/supplier API, not here.
PRINTIFY_API_KEY=change-me

# --- Custom domains & TLS (Module 3, FR-11.2) ---
# Directory Traefik's file provider watches for per-domain router configs
# (docker-compose.yml mounts this as a volume shared with the `traefik`
# service). Locally without Docker, point this at any writable directory.
TRAEFIK_DYNAMIC_CONFIG_DIR=./traefik-dynamic
# Real email for Let's Encrypt expiry/problem notices - used by the `traefik`
# service's ACME resolver (docker-compose.yml), not read by the app itself.
ACME_EMAIL=change-me@example.com

# --- Transactional email ---
# Any provider from docs/tech-stack.md (Resend/SES-class). In local dev, leave
# EMAIL_PROVIDER=console to print emails to the API's stdout instead of sending
# real mail.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@goto5x.com

# --- Theme Engine & Storefront Rendering (Module 4, apps/web) ---
# Comma-separated hostnames (include the port if non-default) that serve the
# platform's own site; any other Host header is treated as a tenant
# storefront request (middleware.ts). Not a secret - set to your real
# platform domain(s) in production.
PLATFORM_HOSTNAMES=localhost:3000,app.localhost:3000,app.localhost

# --- CORS (Module 10) ---
# Comma-separated list of allowed browser origins (scheme+host+port, no
# trailing slash). Leave empty/unset in production - Traefik puts the web
# app and API on the same origin there, so no CORS headers are needed at
# all. Only set this for local dev (web dev server on a different port than
# the API) or when a future mobile app needs cross-origin API access.
CORS_ALLOWED_ORIGINS=http://localhost:3000

IDENTITY_ENCRYPTION_KEY=change-me-generate-a-real-32-byte-key
IDENTITY_FINGERPRINT_HMAC_SECRET=change-me-generate-a-real-secret
