# Copy this file to .env and fill in real values. Never commit the real .env.
# See README.md "Secrets" section for where to obtain/generate each one.

# --- General ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
API_BASE_URL=http://localhost:3000
PORT=3000

# --- Postgres ---
# Superuser credentials used ONLY by scripts/bootstrap-db.sql (one-time, per
# environment) to create the two application roles below. Not used at runtime.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-local-only
POSTGRES_DB=goto5x

# Application roles created by bootstrap-db.sql. Generate real passwords with
# e.g. `openssl rand -base64 32` per environment - never reuse the placeholder.
POSTGRES_RUNTIME_USER=app_runtime
POSTGRES_RUNTIME_PASSWORD=change-me-local-only
POSTGRES_ADMIN_USER=app_admin
POSTGRES_ADMIN_PASSWORD=change-me-local-only

# Full connection strings the app actually uses (must match the roles above).
DATABASE_URL=postgresql://app_runtime:change-me-local-only@localhost:5432/goto5x?schema=public
DATABASE_ADMIN_URL=postgresql://app_admin:change-me-local-only@localhost:5432/goto5x?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with e.g. `openssl rand -hex 32`. Rotating this invalidates every
# active session.
JWT_ACCESS_SECRET=change-me-generate-a-real-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
# TOTP issuer name shown in admins' authenticator apps during MFA enrollment.
ADMIN_MFA_ISSUER_NAME=goto5x.com

# --- Object storage (MinIO) ---
# Not used by Module 1 (no media/file features yet); included so the compose
# stack matches the production topology from day one.
MINIO_ROOT_USER=goto5x-minio
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_ENDPOINT=http://localhost:9000

# --- Transactional email ---
# Any provider from docs/tech-stack.md (Resend/SES-class). In local dev, leave
# EMAIL_PROVIDER=console to print emails to the API's stdout instead of sending
# real mail.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@goto5x.com
