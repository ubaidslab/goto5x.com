// Module 1 (Foundation) schema. Only tables/columns this module actually uses
// are defined here - see docs/build-plan.md "Note on `stores`" for why columns
// like access_mode/last_active_at are deliberately absent until the modules
// that consume them (Discovery, Guard-Rails) are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  unverified
  pending
  verified
}

enum AdminRole {
  super_admin
  support
  // Module 6 (Listing Moderation Engine, SRS §4/FR-27.6) - a narrowly-scoped
  // sub-role, not a general permissions system. AdminAuthGuard denies every
  // admin route to this role by default; only a route explicitly marked
  // @AllowReviewer() (the moderation queue) accepts it.
  reviewer
}

enum StoreStatus {
  active
  suspended
  banned
  archived
}

enum PlanBillingInterval {
  monthly
  yearly
  none
}

// Module 14 (SRS v0.19, FR-7.17) - a plan's addressable group. `individual`
// is the normal self-fulfilled seller plan family (Free/Starter/Standard/
// Pro); `team` is leader-facing (§5.31); `supplier` is FR-7.10, unchanged.
enum PlanGroup {
  individual
  team
  supplier
}

// Module 14 (FR-7.5) - `active` covers the Free Plan too (no billing cycle,
// FR-7.3). `pastDue` intentionally does not exist here - non-payment is
// handled through seller_invoices' own status/grace-period mechanism
// (FR-6.18/FR-7.15), never a parallel subscription-status field.
enum SubscriptionStatus {
  active
  cancelled
}

// Module 14 (FR-7.11/7.12/7.13) - same invite-then-confirm shape as
// store_supplier_links.status (§5.3).
enum TeamMemberStatus {
  pending_invite
  active
  left
  declined
}

enum PromoDiscountType {
  percent
  fixed
}

// Module 14 (FR-7.15/7.18) - which kind of platform-owed debt this
// seller_invoices row represents. All three share the identical manual-
// verification mechanism (FR-6.17) - only the overdue consequence differs
// (branched in InvoicesService, never a parallel invoicing engine).
enum InvoiceType {
  commission
  plan_subscription
  group_sponsorship
}

enum SettingsValueType {
  boolean
  number
  string
  json
}

enum SettingsScopeType {
  global
  plan
  seller
  category
  store
}

enum ProductStatus {
  draft
  active
  archived
}

enum ProductSourceType {
  self
  supplier
}

// Module 6 (Listing Moderation Engine, FR-27.5). `not_required` = never
// queued (trusted seller, or no rule matched); `pending` = in the queue,
// not publicly visible regardless of `status`.
enum ModerationStatus {
  not_required
  pending
  approved
  rejected
}

enum MediaSource {
  upload
  google_drive_import
  // Module 15 (FR-18.1) - the CSV's Image Src is stored as-is (hotlinked),
  // never fetched server-side: fetching an arbitrary seller-supplied URL
  // from the backend is an SSRF vector this importer deliberately avoids.
  // Re-hosting into MinIO is a seller's own choice via the existing upload
  // path, not something this import does on their behalf.
  csv_import
}

enum MediaType {
  image
  video
}

enum DriveConnectionStatus {
  active
  revoked
  expired
}

enum DomainVerificationStatus {
  pending
  verified
  failed
}

enum DomainTlsStatus {
  pending
  issued
  error
}

enum StoreAccessMode {
  public
  coming_soon
  password_protected
}

enum NavigationLocation {
  header
  footer
}

// Module 7 (FR-2.11).
enum DiscountType {
  percentage
  fixed_amount
}

// Module 8 (Supplier Portal, FR-3.1).
enum SupplierVerificationStatus {
  pending
  verified
  rejected
}

// Module 8 (FR-2.6/FR-3.1). Only three states - there is no separate
// "awaiting supplier acceptance" state: per FR-2.6, *either* path (seller
// invites, or supplier self-registers and requests a link) lands in
// `pending_seller_review` - the seller always gives the final go-ahead
// regardless of who initiated contact.
enum StoreSupplierLinkStatus {
  pending_seller_review
  active
  revoked
}

enum InvitedBy {
  seller
  supplier
}

// Module 8 (FR-2.7/FR-3.2). No "auto-publish" path exists - every
// supplier-sourced listing sits here until a seller explicitly decides.
enum ListingReviewStatus {
  pending
  approved
  rejected
}

enum ThemeTier {
  free
  premium
  marketplace
}

model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  phone                      String?
  passwordHash               String?   @map("password_hash")
  roleFlags                  String[]  @map("role_flags")
  mfaEnabled                 Boolean   @default(false) @map("mfa_enabled")
  mfaSecret                  String?   @map("mfa_secret")
  emailVerifiedAt            DateTime? @map("email_verified_at") @db.Timestamptz
  emailVerificationTokenHash String?   @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at") @db.Timestamptz
  passwordResetTokenHash     String?   @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.Timestamptz
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  seller             Seller?
  supplier           Supplier?
  adminUser          AdminUser?
  securityEvents     UserSecurityEvent[]
  targetedPromoCodes PlatformPromoCode[]

  @@map("users")
}

model UserSecurityEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  eventType         String   @map("event_type")
  ipAddress         String?  @map("ip_address")
  // Module 12 (FR-30.5) - a coarse client-supplied fingerprint captured on
  // the "signup" event type only; a score input, never by itself a block
  // trigger (§5.30). Nullable so every pre-existing event type/row is
  // unaffected.
  deviceFingerprint String?  @map("device_fingerprint")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], name: "idx_security_events_user")
  @@map("user_security_events")
}

model Seller {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  businessName   String    @map("business_name")
  kycStatus      KycStatus @default(unverified) @map("kyc_status")
  kycVerifiedAt  DateTime? @map("kyc_verified_at") @db.Timestamptz
  // Module 6 (FR-27.4) - admin-granted only, never auto-earned by a
  // threshold. Bypasses both new-seller probation and the keyword/category
  // moderation queue entirely.
  isTrusted      Boolean   @default(false) @map("is_trusted")
  // Module 10 (FR-28.4) - cosmetic-only dashboard personalization, never the
  // storefront theme (StoreThemeSettings, a separate system). Real plan-gating
  // (higher plans = more options) is documented but not enforced in v1.0 - no
  // Seller-Plan relation exists yet (Module 11 hasn't given sellers a real
  // plan assignment), so every seller currently sees the full preset set.
  dashboardTheme String    @default("default") @map("dashboard_theme")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Module 12 (SRS §5.30, FR-30.1) - CNIC is encrypted at rest (AES-256-GCM,
  // same discipline as the Google Drive refresh token) for retrieval by an
  // authorized flow; cnicHash is a separate deterministic (HMAC) fingerprint
  // used ONLY for the uniqueness constraint below, so uniqueness is
  // enforceable without ever comparing plaintext. Unique across every
  // seller regardless of lifecycleStatus (sellers are never hard-deleted,
  // §3.2) - a banned seller's CNIC can never re-register.
  cnicEncrypted String? @map("cnic_encrypted")
  cnicHash      String? @unique @map("cnic_hash")

  // Module 12 (FR-30.5) - the rule-based risk score's outcome at signup;
  // gates the same FR-6.14-style checkout readiness check, never a
  // dashboard-wide lock. `riskScore` is the raw weighted total (for admin
  // review context), `activationStatus` is the derived 3-way decision.
  riskScore        Int?                   @map("risk_score")
  activationStatus SellerActivationStatus @default(auto_approved) @map("activation_status")

  // Module 12 (FR-29.4) - the T&S enforcement ladder, built on top of the
  // seller-lifecycle admin control this SRS's Admin Control Plane section
  // (FR-8.4) specified but never had a prior module actually build -
  // surfaced as a direct Module 12 dependency, built here (see build-plan.md).
  lifecycleStatus SellerLifecycleStatus @default(active) @map("lifecycle_status")

  // Module 12 (FR-29.1) - versioned Seller Agreement acceptance. Reuses
  // FR-12.1's "versioned content, timestamp+IP acceptance" spirit but is
  // deliberately its own small table (SellerAgreementVersion) rather than
  // the full general-purpose content-pages system, which remains unbuilt
  // (a disclosed, deliberate scope-narrowing - see build-plan.md).
  agreementAcceptedVersion String?   @map("agreement_accepted_version")
  agreementAcceptedAt      DateTime? @map("agreement_accepted_at") @db.Timestamptz
  agreementAcceptedIp      String?   @map("agreement_accepted_ip")

  user             User                          @relation(fields: [userId], references: [id])
  stores           Store[]
  ledgerEntries    LedgerEntry[]
  invoices         SellerInvoice[]
  subscription     Subscription?
  teamsLed         Team[]
  teamMemberships  TeamMember[]
  promoRedemptions PlatformPromoCodeRedemption[]

  @@map("sellers")
}

enum SellerActivationStatus {
  auto_approved
  pending_review
  blocked
}

enum SellerLifecycleStatus {
  active
  warned
  restricted
  suspended
  banned
}

model AdminUser {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  role       AdminRole
  mfaEnabled Boolean   @map("mfa_enabled")

  user User @relation(fields: [userId], references: [id])

  auditLogs         AdminAuditLog[]
  verifiedInvoices  SellerInvoice[]
  promoCodesCreated PlatformPromoCode[]

  @@map("admin_users")
}

model Store {
  id                   String          @id @default(uuid()) @db.Uuid
  sellerId             String          @map("seller_id") @db.Uuid
  name                 String
  slug                 String          @unique
  status               StoreStatus     @default(active)
  // Module 4: pulled forward from its originally-planned Module 5
  // introduction (FR-16.5) - see docs/build-plan.md's Module 4 amendment
  // note. Only the column + noindex/sitemap read-side behavior are in scope
  // here; the coming-soon page content and password-gate flow themselves
  // are Module 5's job (§14.16).
  accessMode           StoreAccessMode @default(public) @map("access_mode")
  // Module 5 (FR-16.5). Set only when accessMode = password_protected;
  // never selected into any API response (StoresService always queries
  // this table with `omit: { accessPasswordHash: true }` outside the one
  // internal password-verification call) - same "never returned" discipline
  // as the Google Drive refresh token (Module 2).
  accessPasswordHash   String?         @map("access_password_hash")
  seoTitle             String?         @map("seo_title")
  seoDescription       String?         @map("seo_description")
  currency             String          @default("PKR")
  // Module 14 (FR-23.2) - updated on meaningful seller activity; the signal
  // the dormant-store job checks. dormantWarningSentAt prevents re-sending
  // the warning email every job run.
  lastActiveAt         DateTime        @default(now()) @map("last_active_at") @db.Timestamptz
  dormantWarningSentAt DateTime?       @map("dormant_warning_sent_at") @db.Timestamptz
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  // Module 15.5 (FR-32.5) - reuses the existing media pipeline (MediaAsset,
  // Module 2) rather than a second upload path; nullable, typographic-mark
  // fallback stays wherever this is unset.
  logoMediaId          String?         @map("logo_media_id") @db.Uuid

  seller              Seller                    @relation(fields: [sellerId], references: [id])
  domains             Domain[]
  themeSettings       StoreThemeSettings?
  collections         Collection[]
  navigationMenus     StoreNavigationMenu[]
  shippingSettings    StoreShippingSettings?
  taxSettings         StoreTaxSettings?
  paymentInstructions StorePaymentInstructions?
  discountCodes       DiscountCode[]
  supplierLinks       StoreSupplierLink[]
  listingReviews      ListingReview[]
  carts               Cart[]
  orders              Order[]
  customers           Customer[]
  importJobs          ImportJob[]
  logoMedia           MediaAsset?               @relation("StoreLogo", fields: [logoMediaId], references: [id])

  @@index([sellerId], name: "idx_stores_seller_id")
  @@map("stores")
}

// Module 3 (Custom Domain & TLS). `created_at` is a genuine addition to the
// documented schema, not a regression - see docs/database-schema.md's note
// on this table for why (every other table has it; this one just never did).
model Domain {
  id                 String                   @id @default(uuid()) @db.Uuid
  storeId            String                   @map("store_id") @db.Uuid
  domainName         String                   @unique @map("domain_name")
  verificationStatus DomainVerificationStatus @default(pending) @map("verification_status")
  tlsStatus          DomainTlsStatus          @default(pending) @map("tls_status")
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  // No separate @@index on domainName - @unique above already creates the
  // btree index the hot-path lookup needs; a second one would be dead weight.
  @@map("domains")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@map("categories")
}

model Product {
  id               String                   @id @default(uuid()) @db.Uuid
  storeId          String                   @map("store_id") @db.Uuid
  categoryId       String?                  @map("category_id") @db.Uuid
  title            String
  description      String?
  status           ProductStatus            @default(draft)
  sourceType       ProductSourceType        @default(self) @map("source_type")
  averageRating    Decimal                  @default(0) @map("average_rating") @db.Decimal(2, 1)
  reviewCount      Int                      @default(0) @map("review_count")
  seoTitle         String?                  @map("seo_title")
  seoDescription   String?                  @map("seo_description")
  // Module 6 (Listing Moderation Engine, FR-27.5). Every public product
  // read path (storefront listing/detail, search, collections) filters on
  // this - see StorefrontService's shared moderation-visible WHERE clause.
  moderationStatus ModerationStatus         @default(not_required) @map("moderation_status")
  moderationNotes  String?                  @map("moderation_notes")
  // Module 5 (Discovery & Merchandising, FR-16.2). Populated by a raw-SQL
  // GENERATED ALWAYS AS ... STORED column (migration) - Prisma can't manage
  // a generated column's value, so it's Unsupported here (read via
  // $queryRaw in ProductsSearchService) rather than modeled as a normal
  // typed field. Deliberately absent until this module actually reads it -
  // see Module 1's precedent on `stores` in docs/build-plan.md: no dead
  // columns, ever.
  searchVector     Unsupported("tsvector")? @map("search_vector")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  category           Category?           @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  media              MediaAsset[]
  collectionProducts CollectionProduct[]
  orderItems         OrderItem[]
  reviews            ProductReview[]

  @@index([storeId, status], name: "idx_products_store_status")
  @@index([moderationStatus], name: "idx_products_moderation_status")
  @@map("products")
}

// Module 5 (Discovery & Merchandising, FR-16.1). Distinct from the global,
// admin-managed `categories` taxonomy - a seller-defined grouping, tenant-
// scoped, a product may belong to several.
model Collection {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  title          String
  slug           String
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  store    Store               @relation(fields: [storeId], references: [id])
  products CollectionProduct[]

  @@unique([storeId, slug], name: "uniq_collection_store_slug")
  @@map("collections")
}

// `store_id` is denormalized directly onto this join table (not resolved
// only through `collections`/`products`) per docs/database-schema.md's
// tenant-strategy note - every tenant table gets the same RLS predicate
// shape, no exceptions to reason about.
model CollectionProduct {
  id           String @id @default(uuid()) @db.Uuid
  storeId      String @map("store_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  collection Collection @relation(fields: [collectionId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([collectionId, productId], name: "uniq_collection_product")
  @@index([collectionId, sortOrder], name: "idx_collection_products_collection")
  @@map("collection_products")
}

// Module 5 (FR-16.3). `items` holds the ordered link/text_block/social_links
// list - see docs/database-schema.md's note on the exact shape. One row per
// (store, location); upserted, never multiple header/footer rows per store.
model StoreNavigationMenu {
  id        String             @id @default(uuid()) @db.Uuid
  storeId   String             @map("store_id") @db.Uuid
  location  NavigationLocation
  items     Json               @default("[]")
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, location], name: "uniq_nav_store_location")
  @@map("store_navigation_menus")
}

// Module 7 (Shipping, Tax & Discounts, FR-2.10). Deliberately simple for
// v1.0 - flat rate + one free-shipping threshold, no zones/weight tiers
// (Phase 2, per SRS). Auto-created with defaults the moment a store is
// created (StoresService.create()), same "never a missing-row state to
// handle" discipline as StoreThemeSettings - a self-fulfilled cart at
// checkout (Module 9) always finds a row here. No `currency` column: read
// via a live join to `stores.currency`, same as documented in
// docs/database-schema.md.
model StoreShippingSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  storeId               String   @unique @map("store_id") @db.Uuid
  flatRate              Decimal  @default(0) @map("flat_rate") @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_shipping_settings")
}

// Module 7 (FR-19.3). One rate per store in v1.0 - no multi-jurisdiction
// tables. Auto-created with defaults alongside StoreShippingSettings; the
// actual tax computation at checkout and invoice itemization are Modules 9
// and 14's job respectively - this table is the seller-configured input
// those later modules read.
model StoreTaxSettings {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @unique @map("store_id") @db.Uuid
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxInclusive Boolean  @default(true) @map("tax_inclusive")
  taxLabel     String   @default("Tax") @map("tax_label")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_tax_settings")
}

// Module 11 prerequisite fix (SRS §5.6c, FR-6.14) - specified in v0.15,
// never actually built until Module 11. v0.16's Trust & Safety additions
// (per-instrument account-title fields, name-consistency status, uniqueness
// fingerprints) are Module 12's own migration - added below.
model StorePaymentInstructions {
  id                String  @id @default(uuid()) @db.Uuid
  storeId           String  @unique @map("store_id") @db.Uuid
  bankAccountTitle  String? @map("bank_account_title")
  bankAccountNumber String? @map("bank_account_number")
  bankName          String? @map("bank_name")
  jazzcashNumber    String? @map("jazzcash_number")
  easypaisaNumber   String? @map("easypaisa_number")
  codEnabled        Boolean @default(false) @map("cod_enabled")

  // Module 12 (FR-30.2) - JazzCash/Easypaisa get their own declared account
  // title (the bank instrument already had one); one shared checkbox
  // declaration covers whichever instruments are filled in on this single
  // per-store row, saved atomically with them.
  jazzcashAccountTitle  String?               @map("jazzcash_account_title")
  easypaisaAccountTitle String?               @map("easypaisa_account_title")
  nameDeclaredSelfOwned Boolean               @default(false) @map("name_declared_self_owned")
  nameConsistencyStatus NameConsistencyStatus @default(not_required) @map("name_consistency_status")

  // Module 12 (FR-30.3) - deterministic (HMAC) fingerprint per instrument,
  // never the plaintext number; a unique constraint across every store
  // platform-wide is the actual hard-block enforcement (Postgres allows
  // multiple NULLs, so an unset instrument never collides).
  bankAccountNumberHash String? @unique @map("bank_account_number_hash")
  jazzcashNumberHash    String? @unique @map("jazzcash_number_hash")
  easypaisaNumberHash   String? @unique @map("easypaisa_number_hash")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_payment_instructions")
}

enum NameConsistencyStatus {
  not_required
  pending
  approved
  rejected
}

// Module 12 (FR-29.1) - a minimal, purpose-scoped version history for the
// Seller Agreement specifically (not the general FR-12.1 content-pages
// system, which remains unbuilt - a disclosed scope-narrowing, see
// build-plan.md). "Current" is simply the highest publishedAt row.
model SellerAgreementVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @unique
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  @@map("seller_agreement_versions")
}

// Module 7 (FR-2.11). CRUD + tenant isolation only - validating a code at
// checkout (expiry/usage-limit/store match, FR-5.5) and incrementing
// `usageCount` atomically are Module 9's job, once checkout exists.
// Advanced types (auto-apply, BOGO, scheduled sales) are Phase 2.
model DiscountCode {
  id         String       @id @default(uuid()) @db.Uuid
  storeId    String       @map("store_id") @db.Uuid
  code       String
  type       DiscountType
  value      Decimal      @db.Decimal(12, 2)
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz
  usageLimit Int?         @map("usage_limit")
  usageCount Int          @default(0) @map("usage_count")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, code], name: "uniq_discount_code_store")
  @@map("discount_codes")
}

// Module 8 (Supplier Portal, FR-3.1). Global profile, same shape as `Seller`
// - a supplier is its own account type, not a Seller sub-role. `role_flags`
// on the underlying User can hold both (`{seller,supplier}`) if the same
// person ever operates as both, but that merge flow is not built in v1.0.
model Supplier {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String                     @unique @map("user_id") @db.Uuid
  businessName       String                     @map("business_name")
  verificationStatus SupplierVerificationStatus @default(pending) @map("verification_status")
  // v1.0 simplification (disclosed, not a silent gap - see
  // docs/build-plan.md's Module 8 section): a full per-supplier Printify
  // OAuth connect flow (mirroring Module 2's Google Drive OAuth) is out of
  // scope for this module. v1.0 ships one platform-level Printify API
  // credential (env var, PrintifyHttpClient) and this one non-secret field
  // - the specific Printify shop that supplier's sync pulls from.
  printifyShopId     String?                    @map("printify_shop_id")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  user       User                @relation(fields: [userId], references: [id])
  storeLinks StoreSupplierLink[]
  listings   SupplierListing[]

  @@map("suppliers")
}

// Module 8 (FR-4.9 registry). Global - mirrors `external_api_clients`'
// enable/disable-without-a-deploy pattern (Module 6 amendment context,
// `docs/architecture.md`). API keys/credentials never live in `config` -
// only non-secret adapter configuration.
model SupplierAdapter {
  id          String   @id @default(uuid()) @db.Uuid
  adapterType String   @unique @map("adapter_type")
  displayName String   @map("display_name")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("supplier_adapters")
}

// Module 8 (FR-2.6/FR-3.1). Tenant (store_id) - RLS-protected the same way
// as every other tenant table, which covers the SELLER's own isolation
// guarantee ("seller A cannot see seller B's supplier links"). A supplier's
// own cross-store view (FR-3.3) necessarily spans multiple sellers' stores
// at once, which no single-seller-keyed RLS policy can express - that read
// path uses PrismaAdminService (BYPASSRLS) with an explicit
// `WHERE supplier_id = ...` filter instead (see SupplierLinksService).
model StoreSupplierLink {
  id         String                  @id @default(uuid()) @db.Uuid
  storeId    String                  @map("store_id") @db.Uuid
  supplierId String                  @map("supplier_id") @db.Uuid
  status     StoreSupplierLinkStatus @default(pending_seller_review)
  invitedBy  InvitedBy               @map("invited_by")
  approvedAt DateTime?               @map("approved_at") @db.Timestamptz
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz

  store          Store           @relation(fields: [storeId], references: [id])
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  listingReviews ListingReview[]

  @@unique([storeId, supplierId], name: "uniq_store_supplier")
  @@index([supplierId, status], name: "idx_ssl_supplier_status")
  @@map("store_supplier_links")
}

// Module 8 (FR-3.2/FR-4.1-4.9). Global - a supplier's catalog, sourced by
// whichever Supplier Adapter (SRS §3.5) is enabled for `adapterType`. Not
// RLS-protected (same "global, admin/supplier-session-scoped at the app
// layer" reasoning as `suppliers`/`supplier_adapters` - see
// docs/database-schema.md's tenant-strategy note).
model SupplierListing {
  id                       String   @id @default(uuid()) @db.Uuid
  supplierId               String   @map("supplier_id") @db.Uuid
  adapterType              String   @map("adapter_type")
  externalProductId        String   @map("external_product_id")
  title                    String
  price                    Decimal  @db.Decimal(12, 2)
  // Module 8 note: Printify (v1.0's only adapter, FR-4.1) is print-on-
  // demand - there is no real finite stock ceiling to sync. This column
  // still exists generically (for CJ Dropshipping, Phase 1.1, FR-4.2,
  // which DOES have real finite inventory) and the atomic decrement
  // mechanism (FR-4.5) is built and tested now against this column
  // directly; wiring it into a live checkout is Module 9's job.
  stockQuantity            Int      @default(999999) @map("stock_quantity")
  shippingCost             Decimal  @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  estimatedDeliveryMinDays Int      @map("estimated_delivery_min_days")
  estimatedDeliveryMaxDays Int      @map("estimated_delivery_max_days")
  supportedCountries       String[] @map("supported_countries")
  rawPayload               Json     @map("raw_payload")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  listingReviews ListingReview[]

  @@unique([supplierId, externalProductId], name: "uniq_supplier_listing_external")
  @@map("supplier_listings")
}

// Module 8 (FR-2.7/FR-3.2). Tenant via `storeId` (denormalized, RLS-
// protected same pattern as `collection_products`) - the seller's approval
// queue. On approval, `productId` is set to the newly-created `products`
// row (source_type = 'supplier') - see ListingReviewsService.approve().
model ListingReview {
  id                  String              @id @default(uuid()) @db.Uuid
  storeId             String              @map("store_id") @db.Uuid
  storeSupplierLinkId String              @map("store_supplier_link_id") @db.Uuid
  supplierListingId   String              @map("supplier_listing_id") @db.Uuid
  status              ListingReviewStatus @default(pending)
  reviewedBy          String?             @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?           @map("reviewed_at") @db.Timestamptz
  productId           String?             @map("product_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  store             Store             @relation(fields: [storeId], references: [id])
  storeSupplierLink StoreSupplierLink @relation(fields: [storeSupplierLinkId], references: [id])
  supplierListing   SupplierListing   @relation(fields: [supplierListingId], references: [id])

  @@index([storeSupplierLinkId, status], name: "idx_listing_reviews_link_status")
  @@map("listing_reviews")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  stockQuantity  Int      @default(0) @map("stock_quantity")
  attributes     Json     @default("{}")

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([productId], name: "idx_variants_product_id")
  @@map("product_variants")
}

model MediaAsset {
  id        String      @id @default(uuid()) @db.Uuid
  storeId   String      @map("store_id") @db.Uuid
  productId String?     @map("product_id") @db.Uuid
  url       String
  source    MediaSource @default(upload)
  type      MediaType
  sortOrder Int         @default(0) @map("sort_order") // Module 10 (FR-28.1) - display order within a product's image set
  isPrimary Boolean     @default(false) @map("is_primary") // Module 10 (FR-28.1) - at most one true per productId, enforced in MediaAssetsService, not the DB
  sizeBytes Int         @default(0) @map("size_bytes") // Module 14 (FR-23.1) - storage-quota metering; set at upload time, never recomputed from MinIO
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  product       Product? @relation(fields: [productId], references: [id])
  logoForStores Store[]  @relation("StoreLogo")

  @@index([storeId], name: "idx_media_store_id")
  @@index([productId], name: "idx_media_product_id")
  @@map("media_assets")
}

model GoogleDriveConnection {
  id                    String                @id @default(uuid()) @db.Uuid
  sellerId              String                @unique @map("seller_id") @db.Uuid
  googleAccountEmail    String                @map("google_account_email")
  refreshTokenEncrypted String                @map("refresh_token_encrypted")
  grantedScopes         String[]              @map("granted_scopes")
  status                DriveConnectionStatus @default(active)
  connectedAt           DateTime              @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt            DateTime?             @map("last_used_at") @db.Timestamptz
  revokedAt             DateTime?             @map("revoked_at") @db.Timestamptz

  @@map("google_drive_connections")
}

// Module 4 (Theme Engine & Storefront Rendering). Global catalog - every
// seller reads the same rows. `tier` is descriptive/future-proofing only in
// v1.0: SRS §14.1's checklist requires every v1.0 template be selectable at
// store creation regardless of plan (no gating enforced yet - that's Module
// 11/14's job to wire to real plan state, same "off for every seller in
// v1.0" precedent as `theme.coded_mode_enabled` below).
model Theme {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  tier            ThemeTier @default(free)
  previewImageUrl String?   @map("preview_image_url")
  version         String    @default("1.0.0")
  isActive        Boolean   @default(true) @map("is_active")

  storeThemeSettings StoreThemeSettings[]

  @@map("themes")
}

// Module 4. Tenant, 1:1 with store - auto-created (with a default theme)
// the moment a store is created, so this row always exists by the time the
// storefront or customizer reads it.
model StoreThemeSettings {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @unique @map("store_id") @db.Uuid
  themeId    String   @map("theme_id") @db.Uuid
  settings   Json     @default("{}")
  customCode String?  @map("custom_code")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])
  theme Theme @relation(fields: [themeId], references: [id])

  @@map("store_theme_settings")
}

model Plan {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String
  // v0.19/FR-7.17 - supersedes the never-shipped v0.15 `plan_type` column
  // (same "which plan family" concept; `team` is a third value, not a
  // parallel axis). tierOrder is this plan's position within its group.
  planGroup             PlanGroup           @default(individual) @map("plan_group")
  tierOrder             Int                 @default(0) @map("tier_order")
  // v0.19/FR-7.18 - only meaningful when planGroup = team: the per-
  // sponsored-seat price Module 11's group-invoice math reads (never a
  // member's own individually-chosen plan price). Null otherwise.
  seatPrice             Decimal?            @map("seat_price") @db.Decimal(12, 2)
  price                 Decimal             @db.Decimal(12, 2)
  currency              String              @default("PKR")
  billingInterval       PlanBillingInterval @map("billing_interval")
  yearlyDiscountPercent Decimal?            @map("yearly_discount_percent") @db.Decimal(5, 2)
  isActive              Boolean             @default(true) @map("is_active")
  sortOrder             Int                 @default(0) @map("sort_order")

  subscriptions        Subscription[] @relation("CurrentPlan")
  pendingSubscriptions Subscription[] @relation("PendingPlan")
  Team                 Team[]

  // Also doubles as PlansService/the seed's natural idempotency key - no
  // two tiers occupy the same position within a group.
  @@unique([planGroup, tierOrder], name: "uniq_plan_group_tier_order")
  @@map("plans")
}

// Module 14 (FR-7.1/7.5) - a seller's real plan assignment. Every seller
// gets one at signup (Free Plan, individual group). This is the piece that
// was missing platform-wide: settings.types.ts's SettingsContext.planId has
// existed since Module 1 but nothing populated it from a real assignment
// until now - see PlansContextService.
model Subscription {
  id                String             @id @default(uuid()) @db.Uuid
  sellerId          String             @unique @map("seller_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  status            SubscriptionStatus @default(active)
  // Null for the Free Plan (no billing cycle, FR-7.3). Set the moment a
  // seller first holds a paid plan; a plan change then always resolves
  // against this rather than "immediately" (FR-7.5).
  currentPeriodEnd  DateTime?          @map("current_period_end") @db.Timestamptz
  // FR-7.5 - a requested change is staged here and applied at
  // currentPeriodEnd by the scheduled cycle job, never immediately, except
  // the one FR-7.5-consistent case where there is no cycle yet to wait for
  // (a Free-Plan seller with no currentPeriodEnd) - see SubscriptionsService.
  pendingPlanId     String?            @map("pending_plan_id") @db.Uuid
  // v0.17/FR-7.11-7.15 - set while this seller is an actively-sponsored team
  // member; null for an unsponsored subscription (including a member who has
  // left, per FR-7.13's graceful downgrade).
  sponsoredByTeamId String?            @map("sponsored_by_team_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  seller          Seller @relation(fields: [sellerId], references: [id])
  plan            Plan   @relation("CurrentPlan", fields: [planId], references: [id])
  pendingPlan     Plan?  @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  sponsoredByTeam Team?  @relation(fields: [sponsoredByTeamId], references: [id])

  @@map("subscriptions")
}

// Module 14 (§5.31, FR-7.11) - the sponsoring seller ("leader"). Eligibility
// (holding a team-leader-eligible plan tier) is checked only at creation
// time, v1.0 (losing eligibility later doesn't retroactively dissolve a team).
model Team {
  id             String   @id @default(uuid()) @db.Uuid
  leaderSellerId String   @map("leader_seller_id") @db.Uuid
  // FR-7.18 - which of the 3 Team tiers this team bills at (seatPrice) -
  // distinct from the leader's own INDIVIDUAL plan tier, which only gates
  // *eligibility* to create a team at all (teams.leader_eligible, bundled
  // onto Standard/Pro per FR-7.16). Chosen at creation; changing it later
  // is a future upgrade (v1.0: fixed for the team's lifetime).
  planId         String   @map("plan_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  leader        Seller          @relation(fields: [leaderSellerId], references: [id])
  plan          Plan            @relation(fields: [planId], references: [id])
  members       TeamMember[]
  subscriptions Subscription[]
  groupInvoices SellerInvoice[]

  @@index([leaderSellerId], name: "idx_teams_leader")
  @@map("teams")
}

// Module 14 (FR-7.11/7.12/7.13) - same invite-then-confirm shape as
// store_supplier_links. The partial unique index enforcing "at most one
// active sponsorship per seller" (FR-7.11) is added via raw SQL in this
// migration - Prisma's schema DSL has no `WHERE` clause for @@unique.
model TeamMember {
  id                String           @id @default(uuid()) @db.Uuid
  teamId            String           @map("team_id") @db.Uuid
  sellerId          String           @map("seller_id") @db.Uuid
  status            TeamMemberStatus @default(pending_invite)
  // FR-7.12 - binding consent; status cannot become 'active' while this is
  // null (enforced in TeamsService, verified directly against the API in
  // §14.31's own checklist item, not just relied on as a comment).
  consentAcceptedAt DateTime?        @map("consent_accepted_at") @db.Timestamptz
  invitedAt         DateTime         @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt          DateTime?        @map("joined_at") @db.Timestamptz
  leftAt            DateTime?        @map("left_at") @db.Timestamptz

  team   Team   @relation(fields: [teamId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([teamId], name: "idx_team_members_team")
  @@index([sellerId], name: "idx_team_members_seller")
  @@map("team_members")
}

// Module 14 (FR-7.9) - subscription-billing discount codes, deliberately a
// separate table from discount_codes (tenant, store-level, checkout
// discounts) - a platform promo code never applies at a seller's storefront.
model PlatformPromoCode {
  id             String            @id @default(uuid()) @db.Uuid
  code           String            @unique
  discountType   PromoDiscountType @map("discount_type")
  discountValue  Decimal           @map("discount_value") @db.Decimal(12, 2)
  targetUserId   String?           @map("target_user_id") @db.Uuid
  maxRedemptions Int               @default(1) @map("max_redemptions")
  redeemedCount  Int               @default(0) @map("redeemed_count")
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  targetUser     User?                         @relation(fields: [targetUserId], references: [id])
  createdByAdmin AdminUser                     @relation(fields: [createdBy], references: [id])
  redemptions    PlatformPromoCodeRedemption[]

  @@map("platform_promo_codes")
}

// Module 14 (FR-7.9) - one row per successful redemption; prevents the same
// seller redeeming the same code twice regardless of maxRedemptions.
model PlatformPromoCodeRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  promoCodeId String   @map("promo_code_id") @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.Timestamptz

  promoCode PlatformPromoCode @relation(fields: [promoCodeId], references: [id])
  seller    Seller            @relation(fields: [sellerId], references: [id])

  @@unique([promoCodeId, sellerId], name: "uniq_promo_redemption_seller")
  @@map("platform_promo_code_redemptions")
}

model SettingsDefinition {
  key           String              @id
  valueType     SettingsValueType   @map("value_type")
  allowedScopes SettingsScopeType[] @map("allowed_scopes")
  defaultValue  Json                @map("default_value")
  validation    Json?
  description   String?

  values SettingsValue[]

  @@map("settings_definitions")
}

model SettingsValue {
  id            String            @id @default(uuid()) @db.Uuid
  definitionKey String            @map("definition_key")
  scopeType     SettingsScopeType @map("scope_type")
  scopeId       String?           @map("scope_id") @db.Uuid
  value         Json
  updatedBy     String?           @map("updated_by") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  definition SettingsDefinition @relation(fields: [definitionKey], references: [key])

  @@unique([definitionKey, scopeType, scopeId], name: "uniq_settings_scope")
  @@map("settings_values")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String?  @map("admin_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt], name: "idx_audit_admin_created")
  @@index([targetType, targetId], name: "idx_audit_target")
  @@map("admin_audit_logs")
}

// Module 3.5/v0.8 amendment: Platform Event Log (SRS §3.11, FR-26.x). Global,
// append-only, same immutability discipline as AdminAuditLog above - no RLS
// (nothing reads this yet; when a reader ships it's admin-only, same as the
// audit log, not seller-facing).
model PlatformEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type")
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  storeId    String?  @map("store_id") @db.Uuid
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventType, createdAt], name: "idx_platform_events_type_created")
  @@index([storeId], name: "idx_platform_events_store")
  @@map("platform_events")
}

// ===== Module 9 (Orders, Cart & Checkout) =====

enum CartStatus {
  active
  abandoned
  converted
  expired
}

// SRS §3.12 Financial Truth Invariant - `pending` is the only status that
// exists before payment is verified; every seller/admin-visible count must
// exclude it. `confirmed` is reached either via a verified gateway webhook
// (Module 10/11, not yet wired) or an explicit manual mark-as-paid
// (FR-17.1, built in this module).
enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
}

enum OrderSource {
  storefront
  manual
}

enum OrderItemFulfillmentStatus {
  pending
  confirmed
  shipped
  delivered
  completed
}

// `manual` is the v1.0 mark-as-paid path (FR-17.1). The others are real
// gateway values reserved for Module 10/11's Safepay integration - not
// used by any code this module writes.
enum PaymentGateway {
  safepay
  cod
  payfast
  jazzcash
  easypaisa
  stripe
  manual
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

// FR-15.1 (locked UX decision) - a row is only ever created once the
// email-first checkout step completes; there is no anonymous/pre-email
// cart row. `convertedOrderId` is a plain scalar (no Prisma relation) -
// nothing needs to traverse Cart -> Order, only record that the
// conversion happened.
model Cart {
  id               String     @id @default(uuid()) @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  buyerEmail       String     @map("buyer_email")
  sessionToken     String     @unique @map("session_token")
  items            Json       @default("[]")
  status           CartStatus @default(active)
  convertedOrderId String?    @map("converted_order_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, status, updatedAt], name: "idx_carts_store_status_updated")
  @@map("carts")
}

// `customer_id` (documented in docs/database-schema.md as a Customers-CRM
// FK) is deliberately absent - the `customers` table doesn't exist until
// Module 14 (Customers, Reviews & Data Portability), which depends on this
// module. Adding it now would be a dangling FK to a table that doesn't
// exist yet; Module 14 adds the column back as a genuine follow-up
// migration, not resurrected dead schema (same discipline as the
// `manual_payment_link_token` precedent already documented for this table).
model Order {
  id                String      @id @default(uuid()) @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  customerId        String?     @map("customer_id") @db.Uuid
  buyerId           String?     @map("buyer_id") @db.Uuid
  buyerEmail        String      @map("buyer_email")
  statusLookupToken String      @unique @map("status_lookup_token")
  shippingAddress   Json        @map("shipping_address")
  status            OrderStatus @default(pending)
  source            OrderSource @default(storefront)
  discountCodeId    String?     @map("discount_code_id") @db.Uuid
  discountAmount    Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  tags              String[]    @default([])
  shippingAmount    Decimal     @map("shipping_amount") @db.Decimal(12, 2)
  taxAmount         Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency          String
  // Module 15 (FR-19.1) - MinIO URL of the generated PDF invoice/receipt,
  // rendered once at order-placement time (the same moment the order-
  // confirmation email already sends) and reused on every subsequent view.
  invoicePdfUrl     String?     @map("invoice_pdf_url")
  placedAt          DateTime    @default(now()) @map("placed_at") @db.Timestamptz

  store          Store                @relation(fields: [storeId], references: [id])
  customer       Customer?            @relation(fields: [customerId], references: [id])
  discountCode   DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  items          OrderItem[]
  notes          OrderNote[]
  timelineEvents OrderTimelineEvent[]
  payments       Payment[]
  ledgerEntries  LedgerEntry[]
  reviews        ProductReview[]

  @@index([storeId, status, placedAt], name: "idx_orders_store_status_date")
  @@index([discountCodeId], name: "idx_orders_discount_code")
  @@index([customerId], name: "idx_orders_customer")
  @@map("orders")
}

// Module 15 (FR-13.1-13.3) - a per-store CRM record, auto-created/matched by
// email at checkout (both storefront and manual orders, FR-17.1) - never a
// buyer account (that's the separate, v1.1 FR-22.1 concept).
model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  email        String
  name         String?
  phone        String?
  ordersCount  Int       @default(0) @map("orders_count")
  totalSpent   Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  firstOrderAt DateTime? @map("first_order_at") @db.Timestamptz
  lastOrderAt  DateTime? @map("last_order_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, email], name: "uniq_customer_store_email")
  @@index([storeId, totalSpent], name: "idx_customers_store_spent")
  @@map("customers")
}

enum ReviewStatus {
  pending
  approved
  hidden
}

// Module 15 (FR-14.1-14.4) - submitted via the order-status link (FR-5.4),
// never an account. `productId`/`orderId` denormalize `storeId` for RLS,
// same pattern as every other tenant table.
model ProductReview {
  id                 String       @id @default(uuid()) @db.Uuid
  storeId            String       @map("store_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  orderId            String?      @map("order_id") @db.Uuid
  buyerName          String       @map("buyer_name")
  buyerEmail         String       @map("buyer_email")
  rating             Int
  body               String
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  status             ReviewStatus @default(pending)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz

  product Product @relation(fields: [productId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId, status], name: "idx_reviews_product_status")
  @@index([storeId, status], name: "idx_reviews_store_status")
  @@map("product_reviews")
}

enum ImportJobType {
  product_import
  product_export
  order_export
}

enum ImportJobStatus {
  pending
  processing
  completed
  failed
}

// Module 15 (FR-18.1-18.3) - a single tracked-job table for all three CSV
// operations, per docs/database-schema.md's pre-documented spec.
model ImportJob {
  id             String          @id @default(uuid()) @db.Uuid
  storeId        String          @map("store_id") @db.Uuid
  type           ImportJobType
  status         ImportJobStatus @default(pending)
  // Source CSV (import) or generated output (export), stored in MinIO.
  fileUrl        String          @map("file_url")
  // FR-18.1 - the CSV columns present in the uploaded file that were not
  // mapped to a core field, surfaced to the seller explicitly per upload.
  unmappedFields String[]        @default([]) @map("unmapped_fields")
  // FR-18.2 - per-row errors for `product_import`; a bad row never fails
  // the whole import.
  errorLog       Json?           @map("error_log")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, status], name: "idx_import_jobs_store_status")
  @@map("import_jobs")
}

// Module 9 clarification: `created_at` is a genuine addition to the
// documented schema (docs/database-schema.md's own table def omitted it,
// but its supplier-tracking index - `(supplier_id, fulfillment_status,
// created_at)` - requires the column to exist; same "every other table has
// it" reasoning already applied to the `Domain` table in Module 3).
model OrderItem {
  id                String                     @id @default(uuid()) @db.Uuid
  storeId           String                     @map("store_id") @db.Uuid
  orderId           String                     @map("order_id") @db.Uuid
  productId         String                     @map("product_id") @db.Uuid
  variantId         String                     @map("variant_id") @db.Uuid
  supplierId        String?                    @map("supplier_id") @db.Uuid
  quantity          Int
  unitPrice         Decimal                    @map("unit_price") @db.Decimal(12, 2)
  shippingCost      Decimal                    @map("shipping_cost") @db.Decimal(12, 2)
  fulfillmentStatus OrderItemFulfillmentStatus @default(pending) @map("fulfillment_status")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  order           Order            @relation(fields: [orderId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  trackingUpdates TrackingUpdate[]

  @@index([supplierId, fulfillmentStatus, createdAt], name: "idx_order_items_supplier_status")
  @@index([orderId], name: "idx_order_items_order_id")
  @@map("order_items")
}

// FR-17.2 - never surfaced on any buyer-facing query.
model OrderNote {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId], name: "idx_order_notes_order")
  @@map("order_notes")
}

// FR-17.4 - append-only; `beforeValue`/`afterValue` follow the same
// discipline as `admin_audit_logs` for `edited` events.
model OrderTimelineEvent {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  eventType   String   @map("event_type")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt], name: "idx_order_timeline_order_created")
  @@map("order_timeline_events")
}

// Module 9 clarification: `store_id` is a genuine addition to the
// documented schema - every other tenant-child table gets it denormalized
// for RLS per docs/database-schema.md's own tenant-strategy rule; this
// table's documented definition omitted it, which would leave it as the
// one tenant-adjacent table with no RLS policy of its own.
model TrackingUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  trackingId  String   @map("tracking_id")
  carrier     String?
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId], name: "idx_tracking_order_item")
  @@map("tracking_updates")
}

// FR-17.1 - `manual` is this module's only writer (mark-as-paid). Real
// gateway integration (Safepay webhook -> `succeeded` payment) is Module
// 10/11's job; the enum/table exist now so that module extends this,
// rather than introduces a competing payment record shape.
model Payment {
  id                   String         @id @default(uuid()) @db.Uuid
  storeId              String         @map("store_id") @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  gateway              PaymentGateway
  gatewayTransactionId String?        @unique @map("gateway_transaction_id")
  amount               Decimal        @db.Decimal(12, 2)
  currency             String
  status               PaymentStatus
  rawWebhookPayload    Json?          @map("raw_webhook_payload")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// Module 11 (Commission & Invoicing Engine, SRS §5.6c). `commission_accrued`/
// `commission_waived` are the only types v1.0 code ever writes - every other
// value is the dormant Platform-Collected mode's (§5.6d), retained verbatim
// for its own eventual reactivation, per docs/database-schema.md's own note.
enum LedgerEntryType {
  sale_credit
  commission_debit
  gateway_fee_debit
  hold_release
  reserve_hold
  reserve_release
  payout_debit
  refund_adjustment
  commission_accrued
  commission_waived
}

model LedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  sellerId         String          @map("seller_id") @db.Uuid
  orderId          String?         @map("order_id") @db.Uuid
  invoiceId        String?         @map("invoice_id") @db.Uuid
  type             LedgerEntryType
  // Signed (+/-): commission_accrued is positive (seller owes the
  // platform), commission_waived is negative (reduces that receivable).
  amount           Decimal         @db.Decimal(12, 2)
  currency         String
  balanceBucket    BalanceBucket?  @map("balance_bucket")
  holdReleaseAt    DateTime?       @map("hold_release_at") @db.Timestamptz
  reserveReleaseAt DateTime?       @map("reserve_release_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  seller  Seller         @relation(fields: [sellerId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])
  invoice SellerInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([sellerId, createdAt], name: "idx_ledger_seller_created")
  @@map("ledger_entries")
}

enum BalanceBucket {
  pending
  available
  reserved
}

enum InvoiceStatus {
  pending
  paid
  overdue
}

model SellerInvoice {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @map("seller_id") @db.Uuid
  // Module 14 (FR-7.15/7.18) - which kind of invoice this is. For
  // `group_sponsorship`, sellerId is the LEADER's id (they're billed, not
  // any member) and teamId identifies which team. Default `commission`
  // preserves every pre-Module-14 row's meaning unchanged.
  invoiceType InvoiceType   @default(commission) @map("invoice_type")
  teamId      String?       @map("team_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Timestamptz
  periodEnd   DateTime      @map("period_end") @db.Timestamptz
  // A snapshot at generation time (sum of that period's commission_accrued/
  // commission_waived entries) - a later ledger entry never silently
  // changes an already-generated invoice.
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency    String
  status      InvoiceStatus @default(pending)
  dueDate     DateTime      @map("due_date") @db.Timestamptz
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz
  paidBy      String?       @map("paid_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  seller        Seller        @relation(fields: [sellerId], references: [id])
  team          Team?         @relation(fields: [teamId], references: [id])
  paidByAdmin   AdminUser?    @relation(fields: [paidBy], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([sellerId, status], name: "idx_seller_invoices_seller_status")
  @@index([status, dueDate], name: "idx_seller_invoices_overdue_check")
  @@map("seller_invoices")
}
