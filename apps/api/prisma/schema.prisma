// Module 1 (Foundation) schema. Only tables/columns this module actually uses
// are defined here - see docs/build-plan.md "Note on `stores`" for why columns
// like access_mode/last_active_at are deliberately absent until the modules
// that consume them (Discovery, Guard-Rails) are built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  unverified
  pending
  verified
}

enum AdminRole {
  super_admin
  support
  // Module 6 (Listing Moderation Engine, SRS §4/FR-27.6) - a narrowly-scoped
  // sub-role, not a general permissions system. AdminAuthGuard denies every
  // admin route to this role by default; only a route explicitly marked
  // @AllowReviewer() (the moderation queue) accepts it.
  reviewer
}

enum StoreStatus {
  active
  // Module 20 (SRS §5.6e, FR-6.25) - the wallet's low-balance grace ladder
  // landed here: storefront browsing behaves like `active` (see
  // StorefrontService.loadActiveStoreOrThrow), only checkout is blocked.
  // Distinct from admin-issued `suspended` - never overwrites one, and a
  // verified top-up lifts this automatically with no admin action.
  orders_paused
  suspended
  banned
  archived
}

enum PlanBillingInterval {
  monthly
  yearly
  none
  // Module 61 (SRS §5.7, FR-7.20) - a subscription billed 5.5x the active
  // monthly price per cycle, covering 6 months of service.
  six_month
}

// Module 14 (SRS v0.19, FR-7.17) - a plan's addressable group. `individual`
// is the normal self-fulfilled seller plan family (First Month/Starter/
// Growth/Pro, v0.33); `team` is leader-facing (§5.31); `supplier` is
// FR-7.10, unchanged.
enum PlanGroup {
  individual
  team
  supplier
}

// Module 14 (FR-7.5) - `active` covers a subscription with no billing
// cycle yet too (e.g. a sponsored team member, FR-7.18). `pastDue`
// intentionally does not exist here - non-payment is
// handled through seller_invoices' own status/grace-period mechanism
// (FR-6.18/FR-7.15), never a parallel subscription-status field.
enum SubscriptionStatus {
  active
  cancelled
}

// Module 14 (FR-7.11/7.12/7.13) - same invite-then-confirm shape as
// store_supplier_links.status (§5.3).
enum TeamMemberStatus {
  pending_invite
  active
  left
  declined
}

enum PromoDiscountType {
  percent
  fixed
}

// Module 14 (FR-7.15/7.18) - which kind of platform-owed debt this
// seller_invoices row represents. All three share the identical manual-
// verification mechanism (FR-6.17) - only the overdue consequence differs
// (branched in InvoicesService, never a parallel invoicing engine).
enum InvoiceType {
  commission
  plan_subscription
  group_sponsorship
}

enum SettingsValueType {
  boolean
  number
  string
  json
  // Module 92 (SRS §5.68/FR-68.2) - a 6-digit #rrggbb hex string, validated
  // by SettingsService.validateValue() the same way a number's min/max is.
  color
}

enum SettingsScopeType {
  global
  plan
  seller
  category
  store
  // Module 20 (SRS §5.6e supplement, FR-7.10) - the supplier-side
  // equivalent of `seller` scope; resolves with higher precedence than
  // `plan`, mirroring FR-8.1's seller > plan > global pattern.
  supplier
}

enum ProductStatus {
  draft
  active
  archived
}

enum ProductSourceType {
  self
  supplier
}

// Module 6 (Listing Moderation Engine, FR-27.5). `not_required` = never
// queued (trusted seller, or no rule matched); `pending` = in the queue,
// not publicly visible regardless of `status`. Module 37 (SRS §5.54/
// FR-54.2) added `admin_removed` - an instant takedown an admin can apply
// to a product in ANY prior status, never included in
// StorefrontService's PUBLIC_MODERATION_STATUSES allowlist, so it's
// excluded from every storefront-visible query without touching any of
// those queries.
enum ModerationStatus {
  not_required
  pending
  approved
  rejected
  admin_removed
}

enum MediaSource {
  upload
  google_drive_import
  // Module 15 (FR-18.1) - the CSV's Image Src is stored as-is (hotlinked),
  // never fetched server-side: fetching an arbitrary seller-supplied URL
  // from the backend is an SSRF vector this importer deliberately avoids.
  // Re-hosting into MinIO is a seller's own choice via the existing upload
  // path, not something this import does on their behalf.
  csv_import
}

enum MediaType {
  image
  video
}

enum DriveConnectionStatus {
  active
  revoked
  expired
}

enum DomainVerificationStatus {
  pending
  verified
  failed
}

enum DomainTlsStatus {
  pending
  issued
  error
}

enum StoreAccessMode {
  public
  coming_soon
  password_protected
}

enum NavigationLocation {
  header
  footer
}

// Module 7 (FR-2.11).
enum DiscountType {
  percentage
  fixed_amount
}

// Module 8 (Supplier Portal, FR-3.1).
enum SupplierVerificationStatus {
  pending
  verified
  rejected
}

// Module 8 (FR-2.6/FR-3.1). Only three states - there is no separate
// "awaiting supplier acceptance" state: per FR-2.6, *either* path (seller
// invites, or supplier self-registers and requests a link) lands in
// `pending_seller_review` - the seller always gives the final go-ahead
// regardless of who initiated contact.
enum StoreSupplierLinkStatus {
  pending_seller_review
  active
  revoked
}

enum InvitedBy {
  seller
  supplier
}

// Module 8 (FR-2.7/FR-3.2). No "auto-publish" path exists - every
// supplier-sourced listing sits here until a seller explicitly decides.
enum ListingReviewStatus {
  pending
  approved
  rejected
}

enum ThemeTier {
  free
  premium
  marketplace
}

model User {
  id                         String    @id @default(uuid()) @db.Uuid
  email                      String    @unique
  phone                      String?
  passwordHash               String?   @map("password_hash")
  roleFlags                  String[]  @map("role_flags")
  mfaEnabled                 Boolean   @default(false) @map("mfa_enabled")
  mfaSecret                  String?   @map("mfa_secret")
  emailVerifiedAt            DateTime? @map("email_verified_at") @db.Timestamptz
  emailVerificationTokenHash String?   @map("email_verification_token_hash")
  emailVerificationExpiresAt DateTime? @map("email_verification_expires_at") @db.Timestamptz
  passwordResetTokenHash     String?   @map("password_reset_token_hash")
  passwordResetExpiresAt     DateTime? @map("password_reset_expires_at") @db.Timestamptz
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  seller             Seller?
  supplier           Supplier?
  adminUser          AdminUser?
  securityEvents     UserSecurityEvent[]
  targetedPromoCodes PlatformPromoCode[]

  @@map("users")
}

model UserSecurityEvent {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  eventType         String   @map("event_type")
  ipAddress         String?  @map("ip_address")
  // Module 12 (FR-30.5) - a coarse client-supplied fingerprint captured on
  // the "signup" event type only; a score input, never by itself a block
  // trigger (§5.30). Nullable so every pre-existing event type/row is
  // unaffected.
  deviceFingerprint String?  @map("device_fingerprint")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], name: "idx_security_events_user")
  @@map("user_security_events")
}

model Seller {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  businessName   String    @map("business_name")
  kycStatus      KycStatus @default(unverified) @map("kyc_status")
  kycVerifiedAt  DateTime? @map("kyc_verified_at") @db.Timestamptz
  // Module 6 (FR-27.4) - admin-granted only, never auto-earned by a
  // threshold. Bypasses both new-seller probation and the keyword/category
  // moderation queue entirely.
  isTrusted      Boolean   @default(false) @map("is_trusted")
  // Module 10 (FR-28.4) - cosmetic-only dashboard personalization, never the
  // storefront theme (StoreThemeSettings, a separate system). Real plan-gating
  // (higher plans = more options) is documented but not enforced in v1.0 - no
  // Seller-Plan relation exists yet (Module 11 hasn't given sellers a real
  // plan assignment), so every seller currently sees the full preset set.
  dashboardTheme String    @default("default") @map("dashboard_theme")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Module 12 (SRS §5.30, FR-30.1) - CNIC is encrypted at rest (AES-256-GCM,
  // same discipline as the Google Drive refresh token) for retrieval by an
  // authorized flow; cnicHash is a separate deterministic (HMAC) fingerprint
  // used ONLY for the uniqueness constraint below, so uniqueness is
  // enforceable without ever comparing plaintext. Unique across every
  // seller regardless of lifecycleStatus (sellers are never hard-deleted,
  // §3.2) - a banned seller's CNIC can never re-register.
  cnicEncrypted String? @map("cnic_encrypted")
  cnicHash      String? @unique @map("cnic_hash")

  // Module 12 (FR-30.5) - the rule-based risk score's outcome at signup;
  // gates the same FR-6.14-style checkout readiness check, never a
  // dashboard-wide lock. `riskScore` is the raw weighted total (for admin
  // review context), `activationStatus` is the derived 3-way decision.
  riskScore        Int?                   @map("risk_score")
  activationStatus SellerActivationStatus @default(auto_approved) @map("activation_status")

  // Module 12 (FR-29.4) - the T&S enforcement ladder, built on top of the
  // seller-lifecycle admin control this SRS's Admin Control Plane section
  // (FR-8.4) specified but never had a prior module actually build -
  // surfaced as a direct Module 12 dependency, built here (see build-plan.md).
  lifecycleStatus SellerLifecycleStatus @default(active) @map("lifecycle_status")

  // Module 55 (SRS §5.62/FR-62.3) - independent per-seller opt-out for the
  // admin-composed platform newsletter only; transactional emails (FR-62.1)
  // are never opt-outable. Mirrors Customer.unsubscribedAt/unsubscribeToken
  // (Module 34) but on a different table for a different audience - a
  // seller's own account, not a store's customer.
  newsletterOptOut           Boolean @default(false) @map("newsletter_opt_out")
  newsletterUnsubscribeToken String? @unique @map("newsletter_unsubscribe_token")

  // Module 20 (SRS §5.6e, FR-6.25) - the wallet's low-balance grace
  // ladder tracking, same "sticky sent-at timestamp" pattern as
  // Store.dormantWarningSentAt (Module 14): set once a warning is sent so
  // the sweep doesn't re-send every run; both cleared the instant balance
  // recovers above the threshold. The wallet is per-seller (one seller can
  // own multiple stores), so this lives here, not on Store - the sweep
  // applies the resulting active/orders_paused transition to every one of
  // this seller's currently-active stores uniformly.
  walletLowBalanceWarningSentAt DateTime? @map("wallet_low_balance_warning_sent_at") @db.Timestamptz
  walletGracePeriodEndsAt       DateTime? @map("wallet_grace_period_ends_at") @db.Timestamptz

  // Module 12 (FR-29.1) - versioned Seller Agreement acceptance. Reuses
  // FR-12.1's "versioned content, timestamp+IP acceptance" spirit but is
  // deliberately its own small table (SellerAgreementVersion) rather than
  // the full general-purpose content-pages system, which remains unbuilt
  // (a disclosed, deliberate scope-narrowing - see build-plan.md).
  agreementAcceptedVersion String?   @map("agreement_accepted_version")
  agreementAcceptedAt      DateTime? @map("agreement_accepted_at") @db.Timestamptz
  agreementAcceptedIp      String?   @map("agreement_accepted_ip")

  user                        User                          @relation(fields: [userId], references: [id])
  stores                      Store[]
  ledgerEntries               LedgerEntry[]
  invoices                    SellerInvoice[]
  subscription                Subscription?
  teamsLed                    Team[]
  teamMemberships             TeamMember[]
  promoRedemptions            PlatformPromoCodeRedemption[]
  templateEntitlements        TemplateEntitlement[]
  templatePurchaseRequests    TemplatePurchaseRequest[]
  apiTokens                   SellerApiToken[]
  impersonationSessions       ImpersonationSession[]
  // Module 22 (SRS §5.33) - a seller may hold participation in more than one
  // program (e.g. Ambassador AND Creator) but never apply to the same
  // program twice (ProgramParticipant's own @@unique enforces that).
  // referralAttributionReceived is this seller's own single, permanent
  // attribution AS A REFERRED SELLER (FR-33.3) - distinct from
  // programParticipations, which is this seller acting AS a referrer/participant.
  programParticipations       ProgramParticipant[]
  referralAttributionReceived ReferralAttribution?          @relation("ReferralAttributionReferred")
  payoutRequests              PayoutRequest[]
  verifiedStoreApplications   VerifiedStoreApplication[]
  dataExports                 SellerDataExport[]
  verificationEmails          SellerVerificationEmail[]
  staffAccounts               StaffAccount[]
  // Module 47 (SRS §5.6e, FR-6.21 amended, new FR-6.29) - the running-total
  // wallet balance cache and its append-only reconciliation-drift log.
  walletBalance               WalletBalance?
  walletReconciliationDrifts  WalletReconciliationDrift[]
  subscriptionAbuseFlags      SubscriptionAbuseFlag[]

  @@map("sellers")
}

// Module 16 (FR-25.5) - a seller-signup attempt from a country not on the
// Settings Registry allowed-list never creates a User/Seller row; the
// applicant's email + country lands here instead, for future launch-
// campaign outreach. Not tenant data (no storeId/sellerId) - same "global,
// no RLS needed" category as `users`/`sellers` themselves.
model SellerSignupWaitlist {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  country   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("seller_signup_waitlist")
}

enum SellerActivationStatus {
  auto_approved
  pending_review
  blocked
}

enum SellerLifecycleStatus {
  active
  warned
  restricted
  suspended
  banned
}

model AdminUser {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @map("user_id") @db.Uuid
  role                    AdminRole
  mfaEnabled              Boolean   @map("mfa_enabled")
  // Module 25 P1 - the admin notification center's read marker (FR-8.x
  // completeness). Null means "never opened the notification center" -
  // every currently-open queue row counts as new, same as any first-run
  // unread-count convention.
  lastSeenNotificationsAt DateTime? @map("last_seen_notifications_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  auditLogs                AdminAuditLog[]
  verifiedInvoices         SellerInvoice[]
  promoCodesCreated        PlatformPromoCode[]
  impersonationSessions    ImpersonationSession[]
  verifiedWalletTopUps     WalletTopUpRequest[]
  verifiedTemplatePurchases TemplatePurchaseRequest[]
  decidedVerifiedStoreApps VerifiedStoreApplication[]
  linkedEmailAccounts      AdminEmailAccount[]
  platformNewsletters      PlatformNewsletter[]

  @@map("admin_users")
}

model Store {
  id                    String          @id @default(uuid()) @db.Uuid
  sellerId              String          @map("seller_id") @db.Uuid
  name                  String
  slug                  String          @unique
  status                StoreStatus     @default(active)
  // Module 4: pulled forward from its originally-planned Module 5
  // introduction (FR-16.5) - see docs/build-plan.md's Module 4 amendment
  // note. Only the column + noindex/sitemap read-side behavior are in scope
  // here; the coming-soon page content and password-gate flow themselves
  // are Module 5's job (§14.16).
  accessMode            StoreAccessMode @default(public) @map("access_mode")
  // Module 5 (FR-16.5). Set only when accessMode = password_protected;
  // never selected into any API response (StoresService always queries
  // this table with `omit: { accessPasswordHash: true }` outside the one
  // internal password-verification call) - same "never returned" discipline
  // as the Google Drive refresh token (Module 2).
  accessPasswordHash    String?         @map("access_password_hash")
  seoTitle              String?         @map("seo_title")
  seoDescription        String?         @map("seo_description")
  currency              String          @default("PKR")
  // Module 14 (FR-23.2) - updated on meaningful seller activity; the signal
  // the dormant-store job checks. dormantWarningSentAt prevents re-sending
  // the warning email every job run.
  lastActiveAt          DateTime        @default(now()) @map("last_active_at") @db.Timestamptz
  dormantWarningSentAt  DateTime?       @map("dormant_warning_sent_at") @db.Timestamptz
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  // Module 15.5 (FR-32.5) - reuses the existing media pipeline (MediaAsset,
  // Module 2) rather than a second upload path; nullable, typographic-mark
  // fallback stays wherever this is unset.
  logoMediaId           String?         @map("logo_media_id") @db.Uuid
  // Module 16 (FR-20.1) - the onboarding wizard's 4th step ("configure a
  // domain or accept the free subdomain") and theme step both have an
  // explicit-acknowledgment path alongside their derived-from-real-action
  // path (see OnboardingService). onboardingCompletedAt is sticky by
  // design (§14.20) - once set, it is never cleared or recomputed, so a
  // later change (e.g. deleting the only product) can never resurrect the
  // wizard for a seller who already finished it.
  onboardingThemeAckAt  DateTime?       @map("onboarding_theme_ack_at") @db.Timestamptz
  onboardingDomainAckAt DateTime?       @map("onboarding_domain_ack_at") @db.Timestamptz
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz
  // Module 20 (SRS §5.6e, FR-6.21) - set once, the moment a seller
  // explicitly publishes this store (payment method + CNIC + minimum
  // wallet top-up all satisfied). Null means "not live yet" - checkout
  // requires this to be set regardless of `status`. Sticky by design, same
  // "never cleared once set" discipline as onboardingCompletedAt.
  publishedAt           DateTime?       @map("published_at") @db.Timestamptz

  // Module 64 (SRS §5.6k, FR-6.41, v0.41) - set the moment
  // WalletGraceLadderService.pauseActiveStores() pauses this store
  // specifically for plan-fee non-payment (never for any other pause
  // reason - overLimitPausedAt below is the separate Module 66 timer, and
  // the two never share a clock). Cleared the instant
  // restoreAfterPlanFeePayment() runs. This is the sole anchor the
  // 14-day-retention scheduled deletion job checks - a store paused for
  // any other reason is never eligible for deletion.
  terminalPausedAt      DateTime?       @map("terminal_paused_at") @db.Timestamptz
  // Module 66 (SRS §5.6k, FR-6.43, v0.41) - set when a downgrade pauses a
  // store beyond the new tier's stores.max_per_seller limit. A 30-day
  // reclaim window; after it elapses the store just stays orders_paused
  // indefinitely (never deleted, never touched by FR-6.41's job, which
  // only ever acts on terminalPausedAt above).
  overLimitPausedAt     DateTime?       @map("over_limit_paused_at") @db.Timestamptz
  // Module 64 (FR-6.41) - one sticky sent-at timestamp per warning
  // milestone, same "sticky timestamp so a sweep never re-sends" pattern
  // as dormantWarningSentAt/walletLowBalanceWarningSentAt. All three are
  // cleared the instant terminalPausedAt is cleared (restoreAfterPlanFeePayment),
  // so a future pause cycle starts the warning sequence fresh.
  retentionWarningDay0SentAt  DateTime? @map("retention_warning_day0_sent_at") @db.Timestamptz
  retentionWarningDay7SentAt  DateTime? @map("retention_warning_day7_sent_at") @db.Timestamptz
  retentionWarningDay13SentAt DateTime? @map("retention_warning_day13_sent_at") @db.Timestamptz
  // Module 65 (SRS §5.6k, FR-6.42) - the win-back email ladder during the
  // same terminalPausedAt-anchored window the three warnings above track;
  // same milestone/reset discipline (cleared alongside terminalPausedAt by
  // restoreAfterPlanFeePayment()), distinct sends with distinct copy from
  // the day0/7/13 deletion warnings above.
  winbackDay3SentAt  DateTime? @map("winback_day3_sent_at") @db.Timestamptz
  winbackDay7SentAt  DateTime? @map("winback_day7_sent_at") @db.Timestamptz
  winbackDay14SentAt DateTime? @map("winback_day14_sent_at") @db.Timestamptz

  // Module 52 (SRS §5.59/FR-59.1) - the next human-readable Order.orderNumber
  // this store will assign, atomically incremented (via a plain UPDATE ...
  // increment, which Postgres serializes per-row) inside the same
  // transaction that creates the order in CheckoutService.placeOrder() - the
  // sole place any order is ever created. Starts at 1 for a brand-new store;
  // backfilled for existing stores to (max existing orderNumber + 1) by this
  // module's migration.
  nextOrderNumber Int @default(1) @map("next_order_number")

  // Module 23 (SRS §5.34, FR-34.1's disclosed schema gap) - freeform,
  // seller-editable, shown on the storefront; exists purely so the Store
  // Health Score's "profile completeness" input has a real policy-text
  // signal to check rather than a placeholder that always scores zero.
  policyText String? @map("policy_text")

  // Module 23 (SRS §5.35, FR-35.4-35.6) - the Verified Store Program's
  // current badge state for this store. Separate from
  // `VerifiedStoreApplication` (below), which is the per-application
  // history/audit-queue row: this is the live, buyer-facing status a
  // single store carries at any moment (never more than one "current"
  // state), while an application is a point-in-time request that resolves
  // into a change to this state. `verifiedStatus = verified` is the ONLY
  // state that renders the storefront/checkout badge (FR-35.4) - every
  // other value (including `pending_re_review`) hides it immediately, by
  // construction, with no separate "hide badge" flag needed.
  verifiedStatus    VerifiedStoreStatus @default(not_verified) @map("verified_status")
  verifiedSince     DateTime?           @map("verified_since") @db.Timestamptz
  verifiedExpiresAt DateTime?           @map("verified_expires_at") @db.Timestamptz
  reReviewFlaggedAt DateTime?           @map("re_review_flagged_at") @db.Timestamptz
  reReviewReason    String?             @map("re_review_reason")

  // Module 57 (SRS §5.64, FR-64.1) - all optional, seller-editable via the
  // existing store settings screen pattern; each renders on generated
  // invoices only when set (FR-64.2), never as a blank placeholder.
  taxNumber         String? @map("tax_number")
  invoiceFooterText String? @map("invoice_footer_text")
  invoiceTermsText  String? @map("invoice_terms_text")

  // Module 58 (SRS §5.65, FR-65.1-65.5) - store-level defaults the
  // Product/Collection-level robots/structured-data/sitemap toggles fall
  // back to when left unset (same cascade shape as seoTitle/seoDescription's
  // existing fallback, resolveSeoFallback()). customHeadTags is sanitized
  // to an explicit meta/link/script[type=application/ld+json] allowlist
  // before storage (FR-65.4) - never rendered unsanitized.
  seoRobotsIndexDefault     Boolean @default(true) @map("seo_robots_index_default")
  seoRobotsFollowDefault    Boolean @default(true) @map("seo_robots_follow_default")
  seoStructuredDataDefault  Boolean @default(true) @map("seo_structured_data_default")
  seoSitemapIncludedDefault Boolean @default(true) @map("seo_sitemap_included_default")
  customHeadTags            String? @map("custom_head_tags")

  seller                    Seller                          @relation(fields: [sellerId], references: [id])
  domains                   Domain[]
  themeSettings             StoreThemeSettings?
  collections               Collection[]
  navigationMenus           StoreNavigationMenu[]
  shippingSettings          StoreShippingSettings?
  taxSettings               StoreTaxSettings?
  paymentInstructions       StorePaymentInstructions?
  paymentGatewayConnections StorePaymentGatewayConnection[]
  discountCodes             DiscountCode[]
  deals                     Deal[]
  supplierLinks             StoreSupplierLink[]
  listingReviews            ListingReview[]
  carts                     Cart[]
  orders                    Order[]
  customers                 Customer[]
  importJobs                ImportJob[]
  logoMedia                 MediaAsset?                     @relation("StoreLogo", fields: [logoMediaId], references: [id])
  healthScoreHistory        StoreHealthScoreHistory[]
  verifiedStoreApplications VerifiedStoreApplication[]
  stockAdjustments          StockAdjustment[]
  orderVerifications        OrderVerification[]
  adSpendEntries            AdSpendEntry[]
  giftCards                 GiftCard[]
  customerSegments          CustomerSegment[]
  emailCampaigns            EmailCampaign[]
  returnRequests            ReturnRequest[]
  milestoneEvents           MilestoneEvent[]
  supportTickets            SupportTicket[]

  @@index([sellerId], name: "idx_stores_seller_id")
  @@map("stores")
}

enum VerifiedStoreStatus {
  not_verified
  pending_re_review
  verified
  revoked
  expired
}

// Module 3 (Custom Domain & TLS). `created_at` is a genuine addition to the
// documented schema, not a regression - see docs/database-schema.md's note
// on this table for why (every other table has it; this one just never did).
model Domain {
  id                 String                   @id @default(uuid()) @db.Uuid
  storeId            String                   @map("store_id") @db.Uuid
  domainName         String                   @unique @map("domain_name")
  verificationStatus DomainVerificationStatus @default(pending) @map("verification_status")
  tlsStatus          DomainTlsStatus          @default(pending) @map("tls_status")
  verifiedAt         DateTime?                @map("verified_at") @db.Timestamptz
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  // No separate @@index on domainName - @unique above already creates the
  // btree index the hot-path lookup needs; a second one would be dead weight.
  @@map("domains")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@map("categories")
}

model Product {
  id                    String                   @id @default(uuid()) @db.Uuid
  storeId               String                   @map("store_id") @db.Uuid
  categoryId            String?                  @map("category_id") @db.Uuid
  title                 String
  description           String?
  status                ProductStatus            @default(draft)
  sourceType            ProductSourceType        @default(self) @map("source_type")
  averageRating         Decimal                  @default(0) @map("average_rating") @db.Decimal(2, 1)
  reviewCount           Int                      @default(0) @map("review_count")
  seoTitle              String?                  @map("seo_title")
  seoDescription        String?                  @map("seo_description")
  // Module 58 (SRS §5.65, FR-65.1-65.3) - advanced SEO fields, plan-gated
  // Growth+ (the pre-existing seoTitle/seoDescription above stay available
  // to every tier, unaffected). null on robotsIndex/robotsFollow/
  // structuredDataEnabled/sitemapIncluded means "inherit the Store-level
  // default" (Store.seoRobotsIndexDefault etc.) - the same cascade shape
  // resolveSeoFallback() already uses for title/description. ogImageMediaId
  // reuses the existing MediaAsset pipeline (no second upload path).
  // structuredDataEnabled has no Collection equivalent - only Product has
  // existing JSON-LD (FR-16.6) to make optional; Collection never had any.
  canonicalUrl          String?                  @map("canonical_url")
  robotsIndex           Boolean?                 @map("robots_index")
  robotsFollow          Boolean?                 @map("robots_follow")
  ogImageMediaId        String?                  @map("og_image_media_id") @db.Uuid
  ogTitle               String?                  @map("og_title")
  ogDescription         String?                  @map("og_description")
  structuredDataEnabled Boolean?                 @map("structured_data_enabled")
  sitemapIncluded       Boolean?                 @map("sitemap_included")
  // FR-65.3 - additive only: the existing UUID-based storefront route is
  // never replaced or redirected. Nullable, unique per store (not
  // globally) - two different sellers may each use "blue-shirt".
  slug                  String?                  @map("slug")
  // Module 6 (Listing Moderation Engine, FR-27.5). Every public product
  // read path (storefront listing/detail, search, collections) filters on
  // this - see StorefrontService's shared moderation-visible WHERE clause.
  moderationStatus      ModerationStatus         @default(not_required) @map("moderation_status")
  moderationNotes       String?                  @map("moderation_notes")
  // Module 50 (SRS §5.57/FR-57.1) - free-form seller-defined tags, dashboard-
  // private by default (FR-57.4). GIN index added via raw SQL in the
  // migration (see idx_products_search's own precedent above) since Prisma's
  // `@@index` can't declare an index type without the extendedIndexes
  // preview feature, which this schema doesn't otherwise need.
  tags                  String[]                 @default([])
  // SRS §5.69/FR-69.1 (Module 94) - ordered array of {key, value} string
  // pairs, buyer-facing by default (contrast with tags above, which stay
  // dashboard-private until FR-57.4's opt-in). Deliberately separate from
  // ProductVariant.attributes (the variant-option JSON) - a custom
  // attribute never creates a purchasable option and has no relationship
  // to ProductVariant at all.
  customAttributes      Json                     @default("[]") @map("custom_attributes")
  // Module 5 (Discovery & Merchandising, FR-16.2). Populated by a raw-SQL
  // GENERATED ALWAYS AS ... STORED column (migration) - Prisma can't manage
  // a generated column's value, so it's Unsupported here (read via
  // $queryRaw in ProductsSearchService) rather than modeled as a normal
  // typed field. Deliberately absent until this module actually reads it -
  // see Module 1's precedent on `stores` in docs/build-plan.md: no dead
  // columns, ever.
  searchVector          Unsupported("tsvector")? @map("search_vector")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  category           Category?           @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  media              MediaAsset[]
  ogImage            MediaAsset?         @relation("ProductOgImage", fields: [ogImageMediaId], references: [id])
  collectionProducts CollectionProduct[]
  orderItems         OrderItem[]
  reviews            ProductReview[]
  dealItems          DealItem[]

  @@unique([storeId, slug], name: "uniq_product_store_slug")
  @@index([storeId, status], name: "idx_products_store_status")
  @@index([moderationStatus], name: "idx_products_moderation_status")
  @@map("products")
}

// Module 5 (Discovery & Merchandising, FR-16.1). Distinct from the global,
// admin-managed `categories` taxonomy - a seller-defined grouping, tenant-
// scoped, a product may belong to several.
model Collection {
  id              String   @id @default(uuid()) @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  title           String
  slug            String
  description     String?
  isActive        Boolean  @default(true) @map("is_active")
  seoTitle        String?  @map("seo_title")
  seoDescription  String?  @map("seo_description")
  // Module 58 (SRS §5.65, FR-65.1/65.2) - same shape/plan-gate as Product's
  // fields above, minus structuredDataEnabled (no JSON-LD exists for
  // collections today - see Product's comment on that field).
  canonicalUrl    String?  @map("canonical_url")
  robotsIndex     Boolean? @map("robots_index")
  robotsFollow    Boolean? @map("robots_follow")
  ogImageMediaId  String?  @map("og_image_media_id") @db.Uuid
  ogTitle         String?  @map("og_title")
  ogDescription   String?  @map("og_description")
  sitemapIncluded Boolean? @map("sitemap_included")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  store    Store               @relation(fields: [storeId], references: [id])
  products CollectionProduct[]
  ogImage  MediaAsset?         @relation("CollectionOgImage", fields: [ogImageMediaId], references: [id])

  @@unique([storeId, slug], name: "uniq_collection_store_slug")
  @@map("collections")
}

// `store_id` is denormalized directly onto this join table (not resolved
// only through `collections`/`products`) per docs/database-schema.md's
// tenant-strategy note - every tenant table gets the same RLS predicate
// shape, no exceptions to reason about.
model CollectionProduct {
  id           String @id @default(uuid()) @db.Uuid
  storeId      String @map("store_id") @db.Uuid
  collectionId String @map("collection_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  collection Collection @relation(fields: [collectionId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@unique([collectionId, productId], name: "uniq_collection_product")
  @@index([collectionId, sortOrder], name: "idx_collection_products_collection")
  @@map("collection_products")
}

// Module 5 (FR-16.3). `items` holds the ordered link/text_block/social_links
// list - see docs/database-schema.md's note on the exact shape. One row per
// (store, location); upserted, never multiple header/footer rows per store.
model StoreNavigationMenu {
  id        String             @id @default(uuid()) @db.Uuid
  storeId   String             @map("store_id") @db.Uuid
  location  NavigationLocation
  items     Json               @default("[]")
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, location], name: "uniq_nav_store_location")
  @@map("store_navigation_menus")
}

// Module 7 (Shipping, Tax & Discounts, FR-2.10). Deliberately simple for
// v1.0 - flat rate + one free-shipping threshold, no zones/weight tiers
// (Phase 2, per SRS). Auto-created with defaults the moment a store is
// created (StoresService.create()), same "never a missing-row state to
// handle" discipline as StoreThemeSettings - a self-fulfilled cart at
// checkout (Module 9) always finds a row here. No `currency` column: read
// via a live join to `stores.currency`, same as documented in
// docs/database-schema.md.
model StoreShippingSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  storeId               String   @unique @map("store_id") @db.Uuid
  flatRate              Decimal  @default(0) @map("flat_rate") @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @map("free_shipping_threshold") @db.Decimal(12, 2)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_shipping_settings")
}

// Module 7 (FR-19.3). One rate per store in v1.0 - no multi-jurisdiction
// tables. Auto-created with defaults alongside StoreShippingSettings; the
// actual tax computation at checkout and invoice itemization are Modules 9
// and 14's job respectively - this table is the seller-configured input
// those later modules read.
model StoreTaxSettings {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @unique @map("store_id") @db.Uuid
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxInclusive Boolean  @default(true) @map("tax_inclusive")
  taxLabel     String   @default("Tax") @map("tax_label")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_tax_settings")
}

// Module 11 prerequisite fix (SRS §5.6c, FR-6.14) - specified in v0.15,
// never actually built until Module 11. v0.16's Trust & Safety additions
// (per-instrument account-title fields, name-consistency status, uniqueness
// fingerprints) are Module 12's own migration - added below.
model StorePaymentInstructions {
  id                String  @id @default(uuid()) @db.Uuid
  storeId           String  @unique @map("store_id") @db.Uuid
  bankAccountTitle  String? @map("bank_account_title")
  bankAccountNumber String? @map("bank_account_number")
  bankName          String? @map("bank_name")
  jazzcashNumber    String? @map("jazzcash_number")
  easypaisaNumber   String? @map("easypaisa_number")
  codEnabled        Boolean @default(false) @map("cod_enabled")

  // Module 12 (FR-30.2) - JazzCash/Easypaisa get their own declared account
  // title (the bank instrument already had one); one shared checkbox
  // declaration covers whichever instruments are filled in on this single
  // per-store row, saved atomically with them.
  jazzcashAccountTitle  String?               @map("jazzcash_account_title")
  easypaisaAccountTitle String?               @map("easypaisa_account_title")
  nameDeclaredSelfOwned Boolean               @default(false) @map("name_declared_self_owned")
  nameConsistencyStatus NameConsistencyStatus @default(not_required) @map("name_consistency_status")

  // Module 12 (FR-30.3) - deterministic (HMAC) fingerprint per instrument,
  // never the plaintext number; a unique constraint across every store
  // platform-wide is the actual hard-block enforcement (Postgres allows
  // multiple NULLs, so an unset instrument never collides).
  bankAccountNumberHash String? @unique @map("bank_account_number_hash")
  jazzcashNumberHash    String? @unique @map("jazzcash_number_hash")
  easypaisaNumberHash   String? @unique @map("easypaisa_number_hash")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@map("store_payment_instructions")
}

// Module 62 (SRS §5.6h, FR-6.36) - a seller's own connected payment
// gateway; a buyer paying through it auto-confirms the order (FR-6.38)
// instead of relying on the manual mark-as-paid fallback. Credentials are
// AES-256-GCM encrypted at rest (payment-gateway-credential-crypto.util.ts,
// its own PAYMENT_GATEWAY_CREDENTIAL_ENCRYPTION_KEY) and never returned by
// any API response (SAFE_SELECT allowlist, same discipline as
// SellerVerificationEmail's SMTP password).
enum PaymentGatewayProvider {
  raast
  easypaisa
  jazzcash
  bank
}

model StorePaymentGatewayConnection {
  id                 String                 @id @default(uuid()) @db.Uuid
  storeId            String                 @map("store_id") @db.Uuid
  provider           PaymentGatewayProvider
  merchantId         String?                @map("merchant_id")
  apiKeyEncrypted    String?                @map("api_key_encrypted")
  apiSecretEncrypted String?                @map("api_secret_encrypted")
  isActive           Boolean                @default(true) @map("is_active")
  // FR-6.36 - stable, seller-visible checkout ordering; Raast defaults to
  // the lowest (first) value, set by the service layer at connect time,
  // never a DB-level default (Raast's priority is business logic, not a
  // schema constant).
  priorityOrder      Int                    @default(0) @map("priority_order")
  // Module 67 (SRS §5.6k, FR-6.44, v0.41) - rolling counters, incremented
  // by every real verifyPayment() call at checkout (never reset) plus the
  // new 6-hourly health-check sweep. successRate is computed from these,
  // never stored - avoids the two ever drifting out of sync.
  verifiedCount      Int                    @default(0) @map("verified_count")
  failedCount        Int                    @default(0) @map("failed_count")
  lastVerifiedAt     DateTime?              @map("last_verified_at") @db.Timestamptz
  // Module 67 (FR-6.44) - "last outage 2h ago"-style admin System Status
  // copy needs a real timestamp to compute from; lastCheckedAt alone can't
  // tell a recent success apart from a recent failure.
  lastFailedAt       DateTime?              @map("last_failed_at") @db.Timestamptz
  lastCheckedAt      DateTime?              @map("last_checked_at") @db.Timestamptz
  connectedAt        DateTime               @default(now()) @map("connected_at") @db.Timestamptz
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  // One connection per provider per store - reconnecting the same provider
  // updates the existing row rather than creating a duplicate.
  @@unique([storeId, provider], name: "uniq_store_gateway_provider")
  @@map("store_payment_gateway_connections")
}

// Founder-directed scope addition - "Platform Merchant Connection": the
// same Module 62 adapter architecture (SellerPaymentGatewayAdapter,
// AES-256-GCM credential encryption), but UZEYN itself is the connected
// merchant, not a seller. Global, admin-managed, no storeId/RLS - same
// shape as ExternalApiClient/Theme. `isActive` deliberately defaults
// FALSE here (opposite of StorePaymentGatewayConnection's `true`) - a
// fresh connection stays dormant until an admin has real credentials and
// explicitly flips it on; the existing manual bank-instructions +
// admin-confirm flow (WalletService.requestPlanFeePayment(),
// TemplatePurchaseService.requestPurchase()) remains the active path
// until then, same "mechanism now, real activation later" discipline
// used everywhere else in this project.
model PlatformGatewayConnection {
  id                 String                 @id @default(uuid()) @db.Uuid
  provider           PaymentGatewayProvider @unique
  merchantId         String?                @map("merchant_id")
  apiKeyEncrypted    String?                @map("api_key_encrypted")
  apiSecretEncrypted String?                @map("api_secret_encrypted")
  isActive           Boolean                @default(false) @map("is_active")
  verifiedCount      Int                    @default(0) @map("verified_count")
  failedCount        Int                    @default(0) @map("failed_count")
  lastVerifiedAt     DateTime?              @map("last_verified_at") @db.Timestamptz
  lastFailedAt       DateTime?              @map("last_failed_at") @db.Timestamptz
  connectedAt        DateTime               @default(now()) @map("connected_at") @db.Timestamptz
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_gateway_connections")
}

// Financial-safety hardening (founder-directed, post-build audit) - the
// idempotency ledger for Platform Merchant Connection's auto-verify path.
// A given (provider, reference) pair can be consumed by tryAutoVerify()
// exactly once, ever - the unique constraint is the actual enforcement
// mechanism (a DB-level guarantee, not just an application-level check),
// so a race between two concurrent requests polling the same real-world
// transaction can never both succeed.
model PlatformGatewayConsumedReference {
  id         String                 @id @default(uuid()) @db.Uuid
  provider   PaymentGatewayProvider
  reference  String
  orderRef   String                 @map("order_ref")
  amount     Decimal                @db.Decimal(12, 2)
  currency   String
  consumedAt DateTime               @default(now()) @map("consumed_at") @db.Timestamptz

  @@unique([provider, reference])
  @@map("platform_gateway_consumed_references")
}

// Financial-safety hardening - "flags for review, doesn't auto-activate"
// for two cases: (1) the gateway's own poll response reports a different
// amount than what was requested (amount_mismatch - the founder's
// explicit requirement), and (2) the weekly reconciliation sweep re-polls
// an already-consumed reference and the gateway no longer confirms it
// (reconciliation_mismatch - e.g. a later reversal/chargeback). Never
// auto-resolved; an admin reviews and marks it resolved explicitly.
model PlatformGatewayFlaggedVerification {
  id               String                 @id @default(uuid()) @db.Uuid
  provider         PaymentGatewayProvider
  orderRef         String                 @map("order_ref")
  reference        String?
  requestedAmount  Decimal                @map("requested_amount") @db.Decimal(12, 2)
  gatewayAmount    Decimal?               @map("gateway_amount") @db.Decimal(12, 2)
  currency         String
  reason           String
  flaggedAt        DateTime               @default(now()) @map("flagged_at") @db.Timestamptz
  resolved         Boolean                @default(false)
  resolvedAt       DateTime?              @map("resolved_at") @db.Timestamptz
  resolvedByAdminId String?               @map("resolved_by_admin_id") @db.Uuid

  @@map("platform_gateway_flagged_verifications")
}

enum NameConsistencyStatus {
  not_required
  pending
  approved
  rejected
}

// Module 12 (FR-29.1) - a minimal, purpose-scoped version history for the
// Seller Agreement specifically (not the general FR-12.1 content-pages
// system, which remains unbuilt - a disclosed scope-narrowing, see
// build-plan.md). "Current" is simply the highest publishedAt row.
model SellerAgreementVersion {
  id          String   @id @default(uuid()) @db.Uuid
  version     String   @unique
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz

  @@map("seller_agreement_versions")
}

// Module 7 (FR-2.11). CRUD + tenant isolation only - validating a code at
// checkout (expiry/usage-limit/store match, FR-5.5) and incrementing
// `usageCount` atomically are Module 9's job, once checkout exists.
// Advanced types (auto-apply, BOGO, scheduled sales) are Phase 2.
model DiscountCode {
  id         String       @id @default(uuid()) @db.Uuid
  storeId    String       @map("store_id") @db.Uuid
  code       String
  type       DiscountType
  value      Decimal      @db.Decimal(12, 2)
  expiresAt  DateTime?    @map("expires_at") @db.Timestamptz
  usageLimit Int?         @map("usage_limit")
  usageCount Int          @default(0) @map("usage_count")
  isActive   Boolean      @default(true) @map("is_active")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, code], name: "uniq_discount_code_store")
  @@map("discount_codes")
}

enum DealStatus {
  draft
  active
  archived
}

// Module 91 (SRS §5.67/FR-67.1) - a seller-created bundle of their own
// products/variants sold together at one uniform percentage off. Mirrors
// DiscountCode's store-scoped shape above; discountPercent is applied
// live against each DealItem's variant's current price at purchase time
// (DealsService.buyNow()) - never snapshotted onto the Deal or DealItem
// row, so a later price edit is reflected immediately, same as every
// other catalog price read.
model Deal {
  id               String     @id @default(uuid()) @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  title            String
  slug             String
  description      String?
  thumbnailMediaId String?    @map("thumbnail_media_id") @db.Uuid
  discountPercent  Decimal    @map("discount_percent") @db.Decimal(5, 2)
  status           DealStatus @default(draft)
  startsAt         DateTime?  @map("starts_at") @db.Timestamptz
  endsAt           DateTime?  @map("ends_at") @db.Timestamptz
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  store          Store       @relation(fields: [storeId], references: [id])
  thumbnailMedia MediaAsset? @relation("DealThumbnail", fields: [thumbnailMediaId], references: [id])
  items          DealItem[]
  orders         Order[]
  carts          Cart[]

  @@unique([storeId, slug], name: "uniq_deal_store_slug")
  @@index([storeId, status], name: "idx_deals_store_status")
  @@map("deals")
}

// Module 91 (SRS §5.67/FR-67.1) - `storeId` denormalized directly onto this
// join table, same tenant-strategy shape as CollectionProduct above (every
// tenant table gets the same RLS predicate, no exceptions to reason about).
model DealItem {
  id        String @id @default(uuid()) @db.Uuid
  storeId   String @map("store_id") @db.Uuid
  dealId    String @map("deal_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  deal    Deal           @relation(fields: [dealId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([dealId, variantId], name: "uniq_deal_item_variant")
  @@index([dealId, sortOrder], name: "idx_deal_items_deal")
  @@map("deal_items")
}

enum GiftCardSource {
  buyer_purchase
  seller_issued
}

// Module 32 (SRS §5.49/FR-49.3) - `pending_payment` is the only status a
// `buyer_purchase` card is ever created in (the Financial Truth Invariant
// gate - a code in this status is unusable at checkout); `seller_issued`
// cards are created directly as `active` (never a revenue event). `active`
// is the only redeemable status; `depleted` is set the instant
// remainingBalance reaches zero (informational - a zero-balance card is
// already unredeemable on its own).
enum GiftCardStatus {
  pending_payment
  active
  depleted
  expired
  cancelled
}

// Module 32 (SRS §5.49, FR-49.1-49.7) - store-scoped, unique-coded, mirrors
// `DiscountCode`'s shape. `remainingBalance` is the atomically-guarded
// source of truth for the redemption race (same "the constraint is the
// source of truth" idiom as `DiscountCode.usageCount` and
// `SupplierListing.decrementStock()`) - always reconcilable against
// `initialValue - sum(giftCardRedemptions.amount)` by construction, since
// both are updated in the same transaction (FR-49.4).
model GiftCard {
  id               String         @id @default(uuid()) @db.Uuid
  storeId          String         @map("store_id") @db.Uuid
  code             String
  source           GiftCardSource
  status           GiftCardStatus @default(pending_payment)
  initialValue     Decimal        @map("initial_value") @db.Decimal(12, 2)
  remainingBalance Decimal        @map("remaining_balance") @db.Decimal(12, 2)
  currency         String
  // Set only for a `buyer_purchase` card - the buyer's email at purchase
  // time, so a seller can confirm payment against a real person.
  purchaserEmail   String?        @map("purchaser_email")
  // Set only for a `seller_issued` card - the seller's own reason
  // (goodwill/refund/etc.), never shown to buyers.
  issuedNote       String?        @map("issued_note")
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz
  // FR-49.3 - the moment a `buyer_purchase` card's payment was confirmed
  // (mirrors Order.placedAt's "when did this become real" role); set at
  // creation time for a `seller_issued` card.
  activatedAt      DateTime?      @map("activated_at") @db.Timestamptz
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz

  store       Store                @relation(fields: [storeId], references: [id])
  redemptions GiftCardRedemption[]

  @@unique([storeId, code], name: "uniq_gift_card_store")
  @@index([storeId, status], name: "idx_gift_cards_store_status")
  @@map("gift_cards")
}

// Module 32 (SRS §5.49/FR-49.4) - append-only; created only alongside the
// same atomic conditional decrement of GiftCard.remainingBalance that
// guards the race, inside the same transaction as the order that consumed
// it. Never updated or deleted.
model GiftCardRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  giftCardId String   @map("gift_card_id") @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  giftCard GiftCard @relation(fields: [giftCardId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([giftCardId], name: "idx_gift_card_redemptions_gift_card")
  @@index([orderId], name: "idx_gift_card_redemptions_order")
  @@map("gift_card_redemptions")
}

// Module 8 (Supplier Portal, FR-3.1). Global profile, same shape as `Seller`
// - a supplier is its own account type, not a Seller sub-role. `role_flags`
// on the underlying User can hold both (`{seller,supplier}`) if the same
// person ever operates as both, but that merge flow is not built in v1.0.
model Supplier {
  id                 String                     @id @default(uuid()) @db.Uuid
  userId             String                     @unique @map("user_id") @db.Uuid
  businessName       String                     @map("business_name")
  verificationStatus SupplierVerificationStatus @default(pending) @map("verification_status")
  // v1.0 simplification (disclosed, not a silent gap - see
  // docs/build-plan.md's Module 8 section): a full per-supplier Printify
  // OAuth connect flow (mirroring Module 2's Google Drive OAuth) is out of
  // scope for this module. v1.0 ships one platform-level Printify API
  // credential (env var, PrintifyHttpClient) and this one non-secret field
  // - the specific Printify shop that supplier's sync pulls from.
  printifyShopId     String?                    @map("printify_shop_id")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  user          User                  @relation(fields: [userId], references: [id])
  storeLinks    StoreSupplierLink[]
  listings      SupplierListing[]
  subscription  Subscription?
  walletEntries SupplierWalletEntry[]

  @@map("suppliers")
}

// Module 8 (FR-4.9 registry). Global - mirrors `external_api_clients`'
// enable/disable-without-a-deploy pattern (Module 6 amendment context,
// `docs/architecture.md`). API keys/credentials never live in `config` -
// only non-secret adapter configuration.
model SupplierAdapter {
  id          String   @id @default(uuid()) @db.Uuid
  adapterType String   @unique @map("adapter_type")
  displayName String   @map("display_name")
  isEnabled   Boolean  @default(true) @map("is_enabled")
  config      Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("supplier_adapters")
}

// Module 8 (FR-2.6/FR-3.1). Tenant (store_id) - RLS-protected the same way
// as every other tenant table, which covers the SELLER's own isolation
// guarantee ("seller A cannot see seller B's supplier links"). A supplier's
// own cross-store view (FR-3.3) necessarily spans multiple sellers' stores
// at once, which no single-seller-keyed RLS policy can express - that read
// path uses PrismaAdminService (BYPASSRLS) with an explicit
// `WHERE supplier_id = ...` filter instead (see SupplierLinksService).
model StoreSupplierLink {
  id         String                  @id @default(uuid()) @db.Uuid
  storeId    String                  @map("store_id") @db.Uuid
  supplierId String                  @map("supplier_id") @db.Uuid
  status     StoreSupplierLinkStatus @default(pending_seller_review)
  invitedBy  InvitedBy               @map("invited_by")
  approvedAt DateTime?               @map("approved_at") @db.Timestamptz
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz

  store          Store           @relation(fields: [storeId], references: [id])
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  listingReviews ListingReview[]

  @@unique([storeId, supplierId], name: "uniq_store_supplier")
  @@index([supplierId, status], name: "idx_ssl_supplier_status")
  @@map("store_supplier_links")
}

// Module 8 (FR-3.2/FR-4.1-4.9). Global - a supplier's catalog, sourced by
// whichever Supplier Adapter (SRS §3.5) is enabled for `adapterType`. Not
// RLS-protected (same "global, admin/supplier-session-scoped at the app
// layer" reasoning as `suppliers`/`supplier_adapters` - see
// docs/database-schema.md's tenant-strategy note).
model SupplierListing {
  id                       String   @id @default(uuid()) @db.Uuid
  supplierId               String   @map("supplier_id") @db.Uuid
  adapterType              String   @map("adapter_type")
  externalProductId        String   @map("external_product_id")
  title                    String
  price                    Decimal  @db.Decimal(12, 2)
  // Module 8 note: Printify (v1.0's only adapter, FR-4.1) is print-on-
  // demand - there is no real finite stock ceiling to sync. This column
  // still exists generically (for CJ Dropshipping, Phase 1.1, FR-4.2,
  // which DOES have real finite inventory) and the atomic decrement
  // mechanism (FR-4.5) is built and tested now against this column
  // directly; wiring it into a live checkout is Module 9's job.
  stockQuantity            Int      @default(999999) @map("stock_quantity")
  shippingCost             Decimal  @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  estimatedDeliveryMinDays Int      @map("estimated_delivery_min_days")
  estimatedDeliveryMaxDays Int      @map("estimated_delivery_max_days")
  supportedCountries       String[] @map("supported_countries")
  rawPayload               Json     @map("raw_payload")
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  listingReviews ListingReview[]

  @@unique([supplierId, externalProductId], name: "uniq_supplier_listing_external")
  @@map("supplier_listings")
}

// Module 8 (FR-2.7/FR-3.2). Tenant via `storeId` (denormalized, RLS-
// protected same pattern as `collection_products`) - the seller's approval
// queue. On approval, `productId` is set to the newly-created `products`
// row (source_type = 'supplier') - see ListingReviewsService.approve().
model ListingReview {
  id                  String              @id @default(uuid()) @db.Uuid
  storeId             String              @map("store_id") @db.Uuid
  storeSupplierLinkId String              @map("store_supplier_link_id") @db.Uuid
  supplierListingId   String              @map("supplier_listing_id") @db.Uuid
  status              ListingReviewStatus @default(pending)
  reviewedBy          String?             @map("reviewed_by") @db.Uuid
  reviewedAt          DateTime?           @map("reviewed_at") @db.Timestamptz
  productId           String?             @map("product_id") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz

  store             Store             @relation(fields: [storeId], references: [id])
  storeSupplierLink StoreSupplierLink @relation(fields: [storeSupplierLinkId], references: [id])
  supplierListing   SupplierListing   @relation(fields: [supplierListingId], references: [id])

  @@index([storeSupplierLinkId, status], name: "idx_listing_reviews_link_status")
  @@map("listing_reviews")
}

model ProductVariant {
  id                  String    @id @default(uuid()) @db.Uuid
  storeId             String    @map("store_id") @db.Uuid
  productId           String    @map("product_id") @db.Uuid
  sku                 String
  price               Decimal   @db.Decimal(12, 2)
  compareAtPrice      Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  stockQuantity       Int       @default(0) @map("stock_quantity")
  // Module 46 (SRS §5.39, FR-39.5 corrected) - self-fulfilled checkout's
  // oversell-protection opt-out. true (default): checkout atomically
  // decrements stockQuantity and rejects the order if not enough remains,
  // the same mechanism already used for supplier-fulfilled items. false:
  // unlimited/untracked stock - checkout never checks or decrements this
  // variant, same as every variant's behavior before this module.
  trackInventory      Boolean   @default(true) @map("track_inventory")
  attributes          Json      @default("{}")
  // Module 31 (SRS §5.42/FR-42.1) - optional COGS input for the P&L
  // engine; null (not 0) when never entered, so PnLService can flag an
  // order's profit as incomplete rather than silently understating it.
  baseCost            Decimal?  @map("base_cost") @db.Decimal(12, 2)
  // Module 55 (SRS §5.62/FR-62.1) - debounces the low-stock alert email: set
  // the instant a decrement first crosses at-or-below the store's
  // `inventory.low_stock_threshold`, cleared back to null the instant a
  // restock brings it back above threshold - so the seller gets exactly one
  // alert per dip, not one per subsequent sale while it stays low.
  lowStockAlertSentAt DateTime? @map("low_stock_alert_sent_at")

  product          Product           @relation(fields: [productId], references: [id])
  orderItems       OrderItem[]
  stockAdjustments StockAdjustment[]
  dealItems        DealItem[]

  @@index([productId], name: "idx_variants_product_id")
  @@map("product_variants")
}

model MediaAsset {
  id        String      @id @default(uuid()) @db.Uuid
  storeId   String      @map("store_id") @db.Uuid
  productId String?     @map("product_id") @db.Uuid
  url       String
  source    MediaSource @default(upload)
  type      MediaType
  sortOrder Int         @default(0) @map("sort_order") // Module 10 (FR-28.1) - display order within a product's image set
  isPrimary Boolean     @default(false) @map("is_primary") // Module 10 (FR-28.1) - at most one true per productId, enforced in MediaAssetsService, not the DB
  sizeBytes Int         @default(0) @map("size_bytes") // Module 14 (FR-23.1) - storage-quota metering; set at upload time, never recomputed from MinIO
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  product               Product?     @relation(fields: [productId], references: [id])
  logoForStores         Store[]      @relation("StoreLogo")
  ogImageForProducts    Product[]    @relation("ProductOgImage")
  ogImageForCollections Collection[] @relation("CollectionOgImage")
  thumbnailForDeals     Deal[]       @relation("DealThumbnail")

  @@index([storeId], name: "idx_media_store_id")
  @@index([productId], name: "idx_media_product_id")
  @@map("media_assets")
}

model GoogleDriveConnection {
  id                    String                @id @default(uuid()) @db.Uuid
  sellerId              String                @unique @map("seller_id") @db.Uuid
  googleAccountEmail    String                @map("google_account_email")
  refreshTokenEncrypted String                @map("refresh_token_encrypted")
  grantedScopes         String[]              @map("granted_scopes")
  status                DriveConnectionStatus @default(active)
  connectedAt           DateTime              @default(now()) @map("connected_at") @db.Timestamptz
  lastUsedAt            DateTime?             @map("last_used_at") @db.Timestamptz
  revokedAt             DateTime?             @map("revoked_at") @db.Timestamptz
  // Module 24 (SRS §5.36, FR-36.3) - the ID of the one dedicated,
  // app-created Drive folder this seller's data exports upload into,
  // created lazily on first successful Drive-delivered export and reused
  // thereafter - never a folder the seller created themselves.
  exportFolderId        String?               @map("export_folder_id")

  @@map("google_drive_connections")
}

// Module 4 (Theme Engine & Storefront Rendering). Global catalog - every
// seller reads the same rows. `tier`'s premium gate is now enforced
// (StoreThemeSettingsService.update(), theme.premium_tier_enabled - Module
// 18's FR-24.5 fix). Templates module (v0.31 design phase) - 4 named,
// visually distinct built-in templates (Editorial/Studio/Market/Atelier)
// plus a 5th "Start from blank" utility option, replacing the original 3
// structurally-only-distinct placeholders.
model Theme {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  tier            ThemeTier @default(free)
  previewImageUrl String?   @map("preview_image_url")
  version         String    @default("1.0.0")
  isActive        Boolean   @default(true) @map("is_active")
  // Deliberate display/default-assignment order (StoresService.create()'s
  // auto-assigned default, ThemesService.listSelectable()'s picker order) -
  // never alphabetical, which would silently make "Start from blank" the
  // accidental default for every new store once it sorts before some
  // template names.
  sortOrder       Int       @default(0) @map("sort_order")
  // Premium Motion Templates (founder-approved scope addition) - the
  // one-time purchase price for a `marketplace`-tier theme bought in-app
  // (TemplatePurchaseRequest below), in PKR. Null for every free/premium
  // theme and for a marketplace theme only ever granted externally via
  // TemplateInstallService (FR-24.3-24.7) - a null price on a marketplace
  // theme means "not purchasable in-app," not "free."
  price           Decimal?  @db.Decimal(12, 2)

  storeThemeSettings StoreThemeSettings[]
  entitlements       TemplateEntitlement[]
  purchaseRequests   TemplatePurchaseRequest[]

  @@map("themes")
}

// Module 18 (SRS §5.24a/§3.10, FR-8.14) - global registry gating the two
// external-SaaS hooks, mirroring `SupplierAdapter` exactly (same "admin can
// enable/disable an integration without a deploy" pattern, §3.5). No RLS -
// every admin-terminal read goes through AdminAuthGuard, same as
// `supplier_adapters`/`themes`. `signingSecretEncrypted` is the AES-256-GCM
// ciphertext of the HMAC signing secret (same encryptDriveToken/
// decryptDriveToken mechanism as the Google Drive refresh token, SRS §6.5) -
// the plaintext is shown to the admin exactly once, at creation, and never
// again; only the ciphertext is ever persisted.
model ExternalApiClient {
  id                     String                @id @default(uuid()) @db.Uuid
  clientType             ExternalApiClientType @unique @map("client_type")
  displayName            String                @map("display_name")
  isEnabled              Boolean               @default(true) @map("is_enabled")
  signingSecretEncrypted String                @map("signing_secret_ref")
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  sellerApiTokens SellerApiToken[]

  @@map("external_api_clients")
}

enum ExternalApiClientType {
  template_store
  social_media_saas
}

// Module 18 (SRS §5.24a, FR-24.3-24.7) - a seller's access to one specific
// marketplace-purchased theme, layered on top of (never instead of) the
// existing plan-based `themes.tier` gating (FR-24.5: both checks must pass
// independently). Seller-scoped directly (not store-scoped) - same RLS
// shape as `google_drive_connections` (a direct `seller_id = ...` policy,
// not the `stores` subquery every store-scoped table uses).
model TemplateEntitlement {
  id                  String                    @id @default(uuid()) @db.Uuid
  sellerId            String                    @map("seller_id") @db.Uuid
  themeId             String                    @map("theme_id") @db.Uuid
  source              TemplateEntitlementSource
  externalPurchaseRef String?                   @map("external_purchase_ref")
  grantedAt           DateTime                  @default(now()) @map("granted_at") @db.Timestamptz
  revokedAt           DateTime?                 @map("revoked_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])
  theme  Theme  @relation(fields: [themeId], references: [id])

  @@unique([sellerId, themeId])
  @@index([sellerId], name: "idx_entitlements_seller")
  @@map("template_entitlements")
}

enum TemplateEntitlementSource {
  built_in
  marketplace_purchase
  // Premium Motion Templates - granted via TemplatePurchaseService.verify()
  // below, UZEYN's own in-app purchase flow. Deliberately distinct from
  // marketplace_purchase (the external Template Store's webhook-driven
  // grant, FR-24.3-24.7) - the two purchase channels must stay
  // distinguishable in the audit trail even though both land on the same
  // TemplateEntitlement shape.
  platform_purchase
}

// Premium Motion Templates (founder-approved scope addition) - a seller's
// one-time purchase claim for a marketplace-tier theme, reusing the exact
// "manual payment-instructions + admin-confirms" pattern WalletTopUpRequest
// already established (same status enum, same requested/verified/verifiedBy
// shape) rather than inventing a second payment system. `amount` is
// snapshotted from Theme.price at request time so a later price change never
// retroactively alters a pending or already-decided request.
model TemplatePurchaseRequest {
  id          String             @id @default(uuid()) @db.Uuid
  sellerId    String             @map("seller_id") @db.Uuid
  themeId     String             @map("theme_id") @db.Uuid
  amount      Decimal            @db.Decimal(12, 2)
  currency    String             @default("PKR")
  status      TopUpRequestStatus @default(pending)
  requestedAt DateTime           @default(now()) @map("requested_at") @db.Timestamptz
  verifiedAt  DateTime?          @map("verified_at") @db.Timestamptz
  verifiedBy  String?            @map("verified_by") @db.Uuid

  seller          Seller     @relation(fields: [sellerId], references: [id])
  theme           Theme      @relation(fields: [themeId], references: [id])
  verifiedByAdmin AdminUser? @relation(fields: [verifiedBy], references: [id])

  @@index([sellerId, status], name: "idx_template_purchases_seller_status")
  @@map("template_purchase_requests")
}

// Module 18 (SRS §5.24b, FR-24.9-24.11) - the Product Feed API's own
// bearer-token auth: presented once at creation (never stored in plaintext,
// only its hash - identical discipline to nothing else needing reversal, so
// a hash rather than encryption is correct here), scoped to exactly one
// seller and one external client, individually revocable. Seller-scoped
// directly, same RLS shape as TemplateEntitlement/google_drive_connections.
model SellerApiToken {
  id        String    @id @default(uuid()) @db.Uuid
  sellerId  String    @map("seller_id") @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  scopes    String[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  seller Seller            @relation(fields: [sellerId], references: [id])
  client ExternalApiClient @relation(fields: [clientId], references: [id])

  @@index([sellerId], name: "idx_seller_tokens_seller")
  @@map("seller_api_tokens")
}

// Module 4. Tenant, 1:1 with store - auto-created (with a default theme)
// the moment a store is created, so this row always exists by the time the
// storefront or customizer reads it.
model StoreThemeSettings {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @unique @map("store_id") @db.Uuid
  themeId    String   @map("theme_id") @db.Uuid
  settings   Json     @default("{}")
  customCode String?  @map("custom_code")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])
  theme Theme @relation(fields: [themeId], references: [id])

  @@map("store_theme_settings")
}

model Plan {
  id                    String              @id @default(uuid()) @db.Uuid
  name                  String
  // v0.19/FR-7.17 - supersedes the never-shipped v0.15 `plan_type` column
  // (same "which plan family" concept; `team` is a third value, not a
  // parallel axis). tierOrder is this plan's position within its group.
  planGroup             PlanGroup           @default(individual) @map("plan_group")
  tierOrder             Int                 @default(0) @map("tier_order")
  // v0.19/FR-7.18 - only meaningful when planGroup = team: the per-
  // sponsored-seat price Module 11's group-invoice math reads (never a
  // member's own individually-chosen plan price). Null otherwise.
  seatPrice             Decimal?            @map("seat_price") @db.Decimal(12, 2)
  price                 Decimal             @db.Decimal(12, 2)
  // v0.33/FR-7.19 - the struck-through "was" price shown beside `price` on
  // the plan editor and public pricing page whenever it's set and exceeds
  // `price`. Null for a tier with no regular/discounted distinction (e.g.
  // a plan created outside the launch-pricing seed). `price` remains the
  // single field actually billed - a further "campaign" price is simply
  // lowering `price` again, never a third field.
  regularPrice          Decimal?            @map("regular_price") @db.Decimal(12, 2)
  // Module 61 (SRS §5.7, FR-7.20) - a one-time discount applied only to a
  // subscription's very first monthly billing cycle; every cycle after
  // that bills at `price` (or `campaignPrice` below, while active) - never
  // a forced transition to a different tier the way the retired "First
  // Month" tier-level mechanism worked.
  firstCyclePrice       Decimal?            @map("first_cycle_price") @db.Decimal(12, 2)
  // Module 61 (FR-7.20) - a second, separately-toggleable discounted price
  // for a time-boxed campaign, without overwriting the standing `price`
  // (which stays intact for when the campaign ends). Resolved alongside
  // `campaignActive` by plan-pricing.util.ts's resolveActivePlanPrice() -
  // never read directly for billing/display.
  campaignPrice         Decimal?            @map("campaign_price") @db.Decimal(12, 2)
  campaignActive        Boolean             @default(false) @map("campaign_active")
  currency              String              @default("PKR")
  billingInterval       PlanBillingInterval @map("billing_interval")
  yearlyDiscountPercent Decimal?            @map("yearly_discount_percent") @db.Decimal(5, 2)
  isActive              Boolean             @default(true) @map("is_active")
  sortOrder             Int                 @default(0) @map("sort_order")

  subscriptions        Subscription[] @relation("CurrentPlan")
  pendingSubscriptions Subscription[] @relation("PendingPlan")
  Team                 Team[]

  // Also doubles as PlansService/the seed's natural idempotency key - no
  // two tiers occupy the same position within a group.
  @@unique([planGroup, tierOrder], name: "uniq_plan_group_tier_order")
  @@map("plans")
}

// Module 14 (FR-7.1/7.5) - a seller's real plan assignment. Every seller
// gets one at signup (First Month, individual group, v0.33 - a real paid
// tier, not a Free Plan). This is the piece that
// was missing platform-wide: settings.types.ts's SettingsContext.planId has
// existed since Module 1 but nothing populated it from a real assignment
// until now - see PlansContextService.
// Module 20 (SRS FR-7.10 supplement) - sellerId became nullable and
// supplierId was added so a supplier can hold a real plan assignment too
// (previously seller-only, the exact gap FR-7.10 flagged as missing).
// Exactly one of sellerId/supplierId is set - enforced by a CHECK
// constraint added by hand in this migration (Prisma has no schema-level
// support for it), the same "Prisma manages columns, migration.sql
// hand-adds what it can't express" pattern RLS policies already use.
model Subscription {
  id                String              @id @default(uuid()) @db.Uuid
  sellerId          String?             @unique @map("seller_id") @db.Uuid
  supplierId        String?             @unique @map("supplier_id") @db.Uuid
  planId            String              @map("plan_id") @db.Uuid
  status            SubscriptionStatus  @default(active)
  // Null when there is no active billing cycle to wait for (e.g. a
  // sponsored team member, FR-7.18) - every seller's OWN subscription gets
  // a real value here from signup onward (v0.33: First Month is a real
  // paid tier, not a Free Plan). A plan change then always resolves
  // against this rather than "immediately" (FR-7.5).
  currentPeriodEnd  DateTime?           @map("current_period_end") @db.Timestamptz
  // FR-7.5 - a requested change is staged here and applied at
  // currentPeriodEnd by the scheduled cycle job, never immediately, except
  // the one FR-7.5-consistent case where there is no cycle yet to wait for
  // (a Free-Plan seller with no currentPeriodEnd) - see SubscriptionsService.
  pendingPlanId     String?             @map("pending_plan_id") @db.Uuid
  // Module 66 (SRS §5.6k, FR-6.43) - the seller's store-choice confirmation
  // from the downgrade request, staged alongside pendingPlanId until the
  // scheduled cycle job (or the immediate-application branch) actually
  // applies it. Empty array means "seller didn't choose" - the default
  // "oldest store stays active" rule applies at that point instead.
  pendingKeepStoreIds String[]          @default([]) @map("pending_keep_store_ids")
  // Module 72 (SRS §5.6k, FR-6.49) - set the moment the one-time first-
  // cycle cancellation refund is posted, so a second cancellation attempt
  // (or any other future check) can never refund the same cycle twice.
  // Null forever for a seller who never qualifies or is never refunded.
  firstCycleRefundedAt DateTime?         @map("first_cycle_refunded_at") @db.Timestamptz
  // Module 61 (SRS §5.7, FR-7.20) - which of the three cycles (monthly/
  // six_month/yearly) this subscription is on; drives both the multiplier
  // PlanFeeDebitService applies on renewal and the span it advances
  // currentPeriodEnd by. Defaults to monthly - every subscription that
  // existed before this column was purely monthly anyway.
  billingInterval   PlanBillingInterval @default(monthly) @map("billing_interval")
  // v0.17/FR-7.11-7.15 - set while this seller is an actively-sponsored team
  // member; null for an unsponsored subscription (including a member who has
  // left, per FR-7.13's graceful downgrade).
  sponsoredByTeamId String?             @map("sponsored_by_team_id") @db.Uuid
  // v0.26/FR-33.1 - captured once, at signup, never backfillable. No
  // Growth & Partner Programs tables exist yet to resolve this against
  // (Module 22) - it is stored as given (shape-validated only) until then.
  referralSource    String?             @map("referral_source")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Module 65 (SRS §5.6k/FR-6.42) - sticky sent-at timestamps for the
  // pre-expiry reminder ladder, same "never re-send" discipline as
  // Store.dormantWarningSentAt. Cleared back to null every time
  // currentPeriodEnd advances (WalletService.verifyTopUp()) so the next
  // billing cycle's reminders fire fresh - unlike Store.terminalPausedAt's
  // warnings, which track a single pause episode, these track ONE cycle
  // and must reset every cycle or they'd only ever fire once, ever.
  renewalReminderDay7SentAt       DateTime? @map("renewal_reminder_day7_sent_at") @db.Timestamptz
  renewalReminderDay3SentAt       DateTime? @map("renewal_reminder_day3_sent_at") @db.Timestamptz
  renewalReminderDay1SentAt       DateTime? @map("renewal_reminder_day1_sent_at") @db.Timestamptz
  renewalReminderExpiryDaySentAt  DateTime? @map("renewal_reminder_expiry_day_sent_at") @db.Timestamptz

  seller          Seller?   @relation(fields: [sellerId], references: [id])
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  plan            Plan      @relation("CurrentPlan", fields: [planId], references: [id])
  pendingPlan     Plan?     @relation("PendingPlan", fields: [pendingPlanId], references: [id])
  sponsoredByTeam Team?     @relation(fields: [sponsoredByTeamId], references: [id])

  @@map("subscriptions")
}

// Module 14 (§5.31, FR-7.11) - the sponsoring seller ("leader"). Eligibility
// (holding a team-leader-eligible plan tier) is checked only at creation
// time, v1.0 (losing eligibility later doesn't retroactively dissolve a team).
model Team {
  id             String   @id @default(uuid()) @db.Uuid
  leaderSellerId String   @map("leader_seller_id") @db.Uuid
  // FR-7.18 - which of the 3 Team tiers this team bills at (seatPrice) -
  // distinct from the leader's own INDIVIDUAL plan tier, which only gates
  // *eligibility* to create a team at all (teams.leader_eligible, bundled
  // onto Standard/Pro per FR-7.16). Chosen at creation; changing it later
  // is a future upgrade (v1.0: fixed for the team's lifetime).
  planId         String   @map("plan_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  leader        Seller          @relation(fields: [leaderSellerId], references: [id])
  plan          Plan            @relation(fields: [planId], references: [id])
  members       TeamMember[]
  subscriptions Subscription[]
  groupInvoices SellerInvoice[]

  @@index([leaderSellerId], name: "idx_teams_leader")
  @@map("teams")
}

// Module 14 (FR-7.11/7.12/7.13) - same invite-then-confirm shape as
// store_supplier_links. The partial unique index enforcing "at most one
// active sponsorship per seller" (FR-7.11) is added via raw SQL in this
// migration - Prisma's schema DSL has no `WHERE` clause for @@unique.
model TeamMember {
  id                String           @id @default(uuid()) @db.Uuid
  teamId            String           @map("team_id") @db.Uuid
  sellerId          String           @map("seller_id") @db.Uuid
  status            TeamMemberStatus @default(pending_invite)
  // FR-7.12 - binding consent; status cannot become 'active' while this is
  // null (enforced in TeamsService, verified directly against the API in
  // §14.31's own checklist item, not just relied on as a comment).
  consentAcceptedAt DateTime?        @map("consent_accepted_at") @db.Timestamptz
  invitedAt         DateTime         @default(now()) @map("invited_at") @db.Timestamptz
  joinedAt          DateTime?        @map("joined_at") @db.Timestamptz
  leftAt            DateTime?        @map("left_at") @db.Timestamptz

  team   Team   @relation(fields: [teamId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([teamId], name: "idx_team_members_team")
  @@index([sellerId], name: "idx_team_members_seller")
  @@map("team_members")
}

// Module 14 (FR-7.9) - subscription-billing discount codes, deliberately a
// separate table from discount_codes (tenant, store-level, checkout
// discounts) - a platform promo code never applies at a seller's storefront.
model PlatformPromoCode {
  id             String            @id @default(uuid()) @db.Uuid
  code           String            @unique
  discountType   PromoDiscountType @map("discount_type")
  discountValue  Decimal           @map("discount_value") @db.Decimal(12, 2)
  targetUserId   String?           @map("target_user_id") @db.Uuid
  maxRedemptions Int               @default(1) @map("max_redemptions")
  redeemedCount  Int               @default(0) @map("redeemed_count")
  expiresAt      DateTime?         @map("expires_at") @db.Timestamptz
  createdBy      String            @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  targetUser     User?                         @relation(fields: [targetUserId], references: [id])
  createdByAdmin AdminUser                     @relation(fields: [createdBy], references: [id])
  redemptions    PlatformPromoCodeRedemption[]

  @@map("platform_promo_codes")
}

// Module 14 (FR-7.9) - one row per successful redemption; prevents the same
// seller redeeming the same code twice regardless of maxRedemptions.
model PlatformPromoCodeRedemption {
  id          String   @id @default(uuid()) @db.Uuid
  promoCodeId String   @map("promo_code_id") @db.Uuid
  sellerId    String   @map("seller_id") @db.Uuid
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.Timestamptz

  promoCode PlatformPromoCode @relation(fields: [promoCodeId], references: [id])
  seller    Seller            @relation(fields: [sellerId], references: [id])

  @@unique([promoCodeId, sellerId], name: "uniq_promo_redemption_seller")
  @@map("platform_promo_code_redemptions")
}

model SettingsDefinition {
  key           String              @id
  valueType     SettingsValueType   @map("value_type")
  allowedScopes SettingsScopeType[] @map("allowed_scopes")
  defaultValue  Json                @map("default_value")
  validation    Json?
  description   String?
  // FR-8.16 (v0.40) - data-driven replacement for the admin Settings
  // Registry editor's prior hardcoded frontend high-impact-key heuristic
  // (billing./commission/platform.maintenance string-match). When true,
  // both the standalone Settings Registry editor and Seller-360's own
  // settings-override mini-editor require the shared admin confirm
  // dialog (old value -> new value) before a write to this key is sent.
  requiresConfirmation Boolean @default(false) @map("requires_confirmation")

  values SettingsValue[]

  @@map("settings_definitions")
}

model SettingsValue {
  id            String            @id @default(uuid()) @db.Uuid
  definitionKey String            @map("definition_key")
  scopeType     SettingsScopeType @map("scope_type")
  scopeId       String?           @map("scope_id") @db.Uuid
  value         Json
  updatedBy     String?           @map("updated_by") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  // D-Studio close-out (founder-requested) - a time-limited admin grant:
  // null (the vast majority of overrides) never expires, unchanged
  // behavior. When set, SettingsService.resolve() treats a row whose
  // expiresAt has passed as if it didn't exist (falls through to the
  // next-lower-precedence scope) - see settings.service.ts's own note on
  // why this reads as a real, verified auto-revert rather than an
  // assumed one.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  // Module 92 (SRS §5.68/FR-68.3) - a general Settings Registry safety
  // mechanism (not color-specific): SettingsService.setValue() rejects any
  // write to a row with locked=true. Defaults false so every pre-existing
  // settings row is unaffected. Toggled only via the dedicated
  // setLocked()/lock endpoint, never as a side effect of a plain value
  // write.
  locked Boolean @default(false)

  definition SettingsDefinition @relation(fields: [definitionKey], references: [key])

  @@unique([definitionKey, scopeType, scopeId], name: "uniq_settings_scope")
  @@map("settings_values")
}

model AdminAuditLog {
  id                     String   @id @default(uuid()) @db.Uuid
  adminUserId            String?  @map("admin_user_id") @db.Uuid
  action                 String
  targetType             String   @map("target_type")
  targetId               String?  @map("target_id") @db.Uuid
  beforeValue            Json?    @map("before_value")
  afterValue             Json?    @map("after_value")
  // Module 17 (FR-8.4) - set on every action taken during an impersonation
  // session; null for an ordinary admin action. Tags the audit trail without
  // needing a second table join to know which rows happened under
  // impersonation.
  impersonationSessionId String?  @map("impersonation_session_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt], name: "idx_audit_admin_created")
  @@index([targetType, targetId], name: "idx_audit_target")
  @@map("admin_audit_logs")
}

// Module 17 (FR-8.4 + v0.23 impersonation-transparency amendment). Global,
// no RLS - the same "already gated by AdminAuthGuard / inherently precedes
// tenant context" category PrismaAdminService's own doc comment describes.
// `expiresAt` is what makes this "time-boxed" real - the impersonation JWT
// itself is signed with this exact expiry (AdminImpersonationService), not
// merely a UI countdown.
model ImpersonationSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  sellerId    String    @map("seller_id") @db.Uuid
  reason      String
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])
  seller    Seller    @relation(fields: [sellerId], references: [id])

  // Seller-facing history read (the seller's Security card) queries by
  // sellerId only, and deliberately never selects adminUserId into that
  // response - see AdminImpersonationService.historyForSeller().
  @@index([sellerId, startedAt], name: "idx_impersonation_seller_started")
  @@map("impersonation_sessions")
}

// Module 17 (FR-12.1). Versioned rich-text platform content (Terms of
// Service, Privacy Policy, Refund Policy, About, Contact) - publishing a
// text change is a data write, never a deploy. Global, no RLS (platform-
// owned, not tenant data); admin-only writes, public reads.
model ContentPage {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  title          String
  bodyHtml       String   @map("body_html")
  currentVersion Int      @default(1) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  revisions ContentPageRevision[]

  @@map("content_pages")
}

model ContentPageRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  contentPageId       String   @map("content_page_id") @db.Uuid
  version             Int
  title               String
  bodyHtml            String   @map("body_html")
  editedByAdminUserId String?  @map("edited_by_admin_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  contentPage ContentPage @relation(fields: [contentPageId], references: [id])

  @@unique([contentPageId, version])
  @@map("content_page_revisions")
}

// Module 17 (FR-12.3). Same versioned-pointer mechanism as ContentPage
// above, applied to the platform's own visual assets rather than text -
// `kind` is "logo" | "favicon" | "hero"; `url` is the asset location
// (uploaded out-of-band, e.g. via the existing MinIO bucket - this table
// only tracks which URL is current and its history, not a new upload
// pipeline).
model PlatformBrandAsset {
  id             String   @id @default(uuid()) @db.Uuid
  kind           String   @unique
  url            String
  currentVersion Int      @default(1) @map("current_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  revisions PlatformBrandAssetRevision[]

  @@map("platform_brand_assets")
}

model PlatformBrandAssetRevision {
  id                  String   @id @default(uuid()) @db.Uuid
  brandAssetId        String   @map("brand_asset_id") @db.Uuid
  version             Int
  url                 String
  editedByAdminUserId String?  @map("edited_by_admin_user_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  brandAsset PlatformBrandAsset @relation(fields: [brandAssetId], references: [id])

  @@unique([brandAssetId, version])
  @@map("platform_brand_asset_revisions")
}

// Module 17 (FR-8.15, extends FR-8.7). Global, no RLS - targeting is
// resolved at the application layer (PlatformMessagesService), same as
// Settings Registry scope resolution, not via row-level security.
model PlatformMessage {
  id                   String                    @id @default(uuid()) @db.Uuid
  channel              PlatformMessageChannel
  targetType           PlatformMessageTargetType @default(all) @map("target_type")
  targetPlanId         String?                   @map("target_plan_id") @db.Uuid
  targetSellerId       String?                   @map("target_seller_id") @db.Uuid
  title                String?
  body                 String
  startsAt             DateTime?                 @map("starts_at") @db.Timestamptz
  endsAt               DateTime?                 @map("ends_at") @db.Timestamptz
  createdByAdminUserId String?                   @map("created_by_admin_user_id") @db.Uuid
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz

  @@index([targetType, targetPlanId, targetSellerId], name: "idx_messages_targeting")
  @@map("platform_messages")
}

enum PlatformMessageChannel {
  banner
  popup
  in_app_notification
}

enum PlatformMessageTargetType {
  all
  plan
  seller
}

// Module 3.5/v0.8 amendment: Platform Event Log (SRS §3.11, FR-26.x). Global,
// append-only, same immutability discipline as AdminAuditLog above - no RLS
// (nothing reads this yet; when a reader ships it's admin-only, same as the
// audit log, not seller-facing).
model PlatformEvent {
  id         String   @id @default(uuid()) @db.Uuid
  eventType  String   @map("event_type")
  actorType  String?  @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  storeId    String?  @map("store_id") @db.Uuid
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventType, createdAt], name: "idx_platform_events_type_created")
  @@index([storeId], name: "idx_platform_events_store")
  @@map("platform_events")
}

// ===== Module 9 (Orders, Cart & Checkout) =====

enum CartStatus {
  active
  abandoned
  converted
  expired
}

// SRS §3.12 Financial Truth Invariant - `pending` is the only status that
// exists before payment is verified; every seller/admin-visible count must
// exclude it. `confirmed` is reached either via a verified gateway webhook
// (Module 10/11, not yet wired) or an explicit manual mark-as-paid
// (FR-17.1, built in this module).
enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  completed
  cancelled
  disputed
  // Module 53 (SRS §5.60/FR-60.4) - terminal outcomes of a completed
  // ReturnRequest. Deliberately excluded from PnLService's/
  // UnitEconomicsService's CONFIRMED_OR_BEYOND-style revenue gates (both of
  // them, per the FR text - a partially_refunded order's remaining kept
  // amount is not re-attributed, it simply stops counting, the same "one
  // signal, applied uniformly" simplification the Financial Truth Invariant
  // calls for here) - see order-status-transitions.util.ts for the map that
  // reaches these two states.
  refunded
  partially_refunded
}

enum OrderSource {
  storefront
  manual
}

enum OrderItemFulfillmentStatus {
  pending
  confirmed
  shipped
  delivered
  completed
}

// `manual` is the v1.0 mark-as-paid path (FR-17.1). The others are real
// gateway values reserved for Module 10/11's Safepay integration - not
// used by any code this module writes.
enum PaymentGateway {
  safepay
  cod
  payfast
  jazzcash
  easypaisa
  stripe
  manual
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

// FR-15.1 (locked UX decision) - a row is only ever created once the
// email-first checkout step completes; there is no anonymous/pre-email
// cart row. `convertedOrderId` is a plain scalar (no Prisma relation) -
// nothing needs to traverse Cart -> Order, only record that the
// conversion happened.
model Cart {
  id               String     @id @default(uuid()) @db.Uuid
  storeId          String     @map("store_id") @db.Uuid
  buyerEmail       String     @map("buyer_email")
  // Module 26 (SRS §5.37/FR-37.8) - collected at checkout for stores that
  // need it (the WhatsApp OTP verification channel); optional since most
  // stores never require it.
  buyerWhatsapp    String?    @map("buyer_whatsapp")
  sessionToken     String     @unique @map("session_token")
  items            Json       @default("[]")
  status           CartStatus @default(active)
  convertedOrderId String?    @map("converted_order_id") @db.Uuid
  // Module 91 (SRS §5.67/FR-67.2) - set only by DealsService.buyNow(), never
  // buyer-settable via UpdateCartDto; CartService.update() nulls this back
  // out the instant a buyer edits a deal cart's item list, since the
  // uniform discount is only valid for the deal's exact item set (closes
  // the "pad in extra products to get them discounted too" abuse vector).
  dealId           String?    @map("deal_id") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])
  deal  Deal? @relation(fields: [dealId], references: [id])

  @@index([storeId, status, updatedAt], name: "idx_carts_store_status_updated")
  @@index([dealId], name: "idx_carts_deal")
  @@map("carts")
}

// `customer_id` (documented in docs/database-schema.md as a Customers-CRM
// FK) is deliberately absent - the `customers` table doesn't exist until
// Module 14 (Customers, Reviews & Data Portability), which depends on this
// module. Adding it now would be a dangling FK to a table that doesn't
// exist yet; Module 14 adds the column back as a genuine follow-up
// migration, not resurrected dead schema (same discipline as the
// `manual_payment_link_token` precedent already documented for this table).
model Order {
  id                String      @id @default(uuid()) @db.Uuid
  storeId           String      @map("store_id") @db.Uuid
  // Module 52 (SRS §5.59/FR-59.1) - a per-store sequential, human-readable
  // identifier (displayed as "#1042"), assigned atomically from
  // Store.nextOrderNumber at creation time in CheckoutService.placeOrder().
  // Orders were UUID-addressed only before this - FR-59.3's CSV tracking
  // upload needs something a seller can actually read and type into a
  // spreadsheet cell, not a raw UUID.
  orderNumber       Int         @map("order_number")
  customerId        String?     @map("customer_id") @db.Uuid
  buyerId           String?     @map("buyer_id") @db.Uuid
  buyerEmail        String      @map("buyer_email")
  // Module 26 (SRS §5.37/FR-37.8) - same optional-unless-the-store-needs-it
  // field as Cart.buyerWhatsapp, carried forward at checkout.
  buyerWhatsapp     String?     @map("buyer_whatsapp")
  statusLookupToken String      @unique @map("status_lookup_token")
  shippingAddress   Json        @map("shipping_address")
  status            OrderStatus @default(pending)
  source            OrderSource @default(storefront)
  discountCodeId    String?     @map("discount_code_id") @db.Uuid
  discountAmount    Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  // Module 91 (SRS §5.67/FR-67.2) - same optional-FK pattern as
  // discountCodeId above; traces a completed order back to the Deal that
  // produced it (buy-now flow), purely informational for FR-67.5's
  // analytics card - never read by checkout/pricing logic itself, which
  // already applied the live-computed discount before the order existed.
  dealId            String?     @map("deal_id") @db.Uuid
  // Module 32 (SRS §5.49/FR-49.5) - a redeemed gift card is a payment
  // reduction against the already-computed total, never a price discount
  // (unlike discountAmount, it plays no part in computeOrderTotals()'s
  // tax/shipping math) - the seller still collects `totalAmount -
  // giftCardAmount` via the normal Direct Seller Collection flow, and
  // commission (FR-49.5) is accrued on the full totalAmount regardless.
  giftCardAmount    Decimal     @default(0) @map("gift_card_amount") @db.Decimal(12, 2)
  tags              String[]    @default([])
  shippingAmount    Decimal     @map("shipping_amount") @db.Decimal(12, 2)
  taxAmount         Decimal     @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(12, 2)
  currency          String
  // Module 31 (SRS §5.42/FR-42.1) - optional seller-entered per-order
  // costs for the P&L engine; unlike ProductVariant.baseCost, a missing
  // value here is genuinely zero (not every order has one), so PnLService
  // never flags these two as incomplete.
  courierCost       Decimal?    @map("courier_cost") @db.Decimal(12, 2)
  handlingCost      Decimal?    @map("handling_cost") @db.Decimal(12, 2)
  // Module 15 (FR-19.1) - MinIO URL of the generated PDF invoice/receipt,
  // rendered once at order-placement time (the same moment the order-
  // confirmation email already sends) and reused on every subsequent view.
  invoicePdfUrl     String?     @map("invoice_pdf_url")
  placedAt          DateTime    @default(now()) @map("placed_at") @db.Timestamptz
  // Phase 5 (founder-requested "missing tracking" alert) - set once this
  // order has been alerted on by MissingTrackingAlertService's sweep, so a
  // repeat sweep run never re-alerts the same order. Naturally stops
  // mattering once the order leaves the "awaitingTracking" bucket (moves
  // to shipped/cancelled/etc.) - no reset needed, this is a one-time flag.
  missingTrackingAlertedAt DateTime? @map("missing_tracking_alerted_at") @db.Timestamptz

  store               Store                @relation(fields: [storeId], references: [id])
  customer            Customer?            @relation(fields: [customerId], references: [id])
  discountCode        DiscountCode?        @relation(fields: [discountCodeId], references: [id])
  deal                Deal?                @relation(fields: [dealId], references: [id])
  items               OrderItem[]
  notes               OrderNote[]
  timelineEvents      OrderTimelineEvent[]
  payments            Payment[]
  ledgerEntries       LedgerEntry[]
  reviews             ProductReview[]
  // Module 26 (SRS §5.37) - present only for a store with
  // orders.verification_channel != "none" at order-placement time; absent
  // entirely means "this order never needed verification," not "pending."
  verification        OrderVerification?
  // Module 32 (SRS §5.49/FR-49.4) - the append-only redemption ledger; an
  // order may carry at most one redemption in v1.0 (one gift card per
  // checkout), but this stays a list for the same reason LedgerEntry does -
  // the audit trail, not a single mutable pointer.
  giftCardRedemptions GiftCardRedemption[]
  // Module 53 (SRS §5.60/FR-60.1) - a list, never a single mutable pointer,
  // since one order may go through multiple partial-refund rounds.
  returnRequests      ReturnRequest[]

  @@unique([storeId, orderNumber], name: "uniq_orders_store_order_number")
  @@index([storeId, status, placedAt], name: "idx_orders_store_status_date")
  @@index([discountCodeId], name: "idx_orders_discount_code")
  @@index([dealId], name: "idx_orders_deal")
  @@index([customerId], name: "idx_orders_customer")
  @@map("orders")
}

enum ReturnRequestStatus {
  requested
  approved
  rejected
  completed
}

// Module 53 (SRS §5.60/FR-60.1) - promotes and completes the `return_requests`
// table docs/database-schema.md already reserved (v1.1-ahead, formerly
// FR-22.3), extended with the partial-refund fields the founder's Module 53
// spec adds (refundAmount/refundedItems/adminOverride). `resolvedByType`/
// `resolvedByUserId` are a plain polymorphic actor pair (no FK relation),
// same shape as EventLog.actorType/actorId - the resolver is either a
// seller's own dashboard user or an admin, never a single FK target.
model ReturnRequest {
  id               String              @id @default(uuid()) @db.Uuid
  storeId          String              @map("store_id") @db.Uuid
  orderId          String              @map("order_id") @db.Uuid
  buyerReason      String              @map("buyer_reason")
  status           ReturnRequestStatus @default(requested)
  requestedAt      DateTime            @default(now()) @map("requested_at") @db.Timestamptz
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz
  resolvedByType   String?             @map("resolved_by_type")
  resolvedByUserId String?             @map("resolved_by_user_id") @db.Uuid
  // Set only once the return actually completes (approved -> completed);
  // null for a still-open or rejected request - there is no refund to speak
  // of yet.
  refundAmount     Decimal?            @map("refund_amount") @db.Decimal(12, 2)
  refundedItems    Json?               @map("refunded_items")
  sellerNote       String?             @map("seller_note")
  adminOverride    Boolean             @default(false) @map("admin_override")

  store Store @relation(fields: [storeId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([storeId, status], name: "idx_return_requests_store_status")
  @@index([orderId], name: "idx_return_requests_order")
  @@map("return_requests")
}

// Module 15 (FR-13.1-13.3) - a per-store CRM record, auto-created/matched by
// email at checkout (both storefront and manual orders, FR-17.1) - never a
// buyer account (that's the separate, v1.1 FR-22.1 concept).
model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  email        String
  name         String?
  phone        String?
  ordersCount  Int       @default(0) @map("orders_count")
  totalSpent   Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  firstOrderAt DateTime? @map("first_order_at") @db.Timestamptz
  lastOrderAt  DateTime? @map("last_order_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  // Module 34 (SRS §5.51/FR-51.3) - permanent, store-scoped suppression
  // from every future campaign send, regardless of which segment this
  // customer would otherwise match. Unlike password-reset/email-verify
  // tokens (auth/token.util.ts), the raw value is stored directly rather
  // than hashed: it must be re-derivable so the SAME unsubscribe link
  // keeps working for a customer across every future campaign, and the
  // worst case of this value leaking is an unwanted unsubscribe, not an
  // account takeover - hashing would only break that reusability for no
  // real security gain. Lazily generated on first campaign send.
  unsubscribedAt   DateTime? @map("unsubscribed_at") @db.Timestamptz
  unsubscribeToken String?   @unique @map("unsubscribe_token")

  store  Store   @relation(fields: [storeId], references: [id])
  orders Order[]

  @@unique([storeId, email], name: "uniq_customer_store_email")
  @@index([storeId, totalSpent], name: "idx_customers_store_spent")
  @@map("customers")
}

// Module 33 (SRS §5.50/FR-50.1-50.6) - a saved filter, not a materialized
// member list (FR-50.2/50.4): typed nullable columns rather than a JSON
// criteria blob, since the dimension set is small and fixed (order count/
// spend/last-order-date ranges, location) - more queryable/indexable than
// JSON, and this codebase's established preference (JSON is reserved for
// genuinely free-form data like shipping_address, not a fixed filter
// shape). Membership is always resolved live by CustomerSegmentsService
// against Customer's existing ordersCount/totalSpent/lastOrderAt
// (FR-13.x) - this table has no member-list column of its own.
model CustomerSegment {
  id      String @id @default(uuid()) @db.Uuid
  storeId String @map("store_id") @db.Uuid
  name    String

  minOrders       Int?      @map("min_orders")
  maxOrders       Int?      @map("max_orders")
  minTotalSpent   Decimal?  @map("min_total_spent") @db.Decimal(12, 2)
  maxTotalSpent   Decimal?  @map("max_total_spent") @db.Decimal(12, 2)
  // FR-50.3 - derived from each candidate customer's most recent order's
  // shipping address at match time (no location column on Customer
  // itself - buyer accounts don't exist in v1.0, so a past order's
  // shipping address is the only location signal that exists).
  lastOrderAfter  DateTime? @map("last_order_after") @db.Timestamptz
  lastOrderBefore DateTime? @map("last_order_before") @db.Timestamptz
  locationCity    String?   @map("location_city")
  locationCountry String?   @map("location_country")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  store     Store           @relation(fields: [storeId], references: [id])
  campaigns EmailCampaign[]

  @@index([storeId], name: "idx_customer_segments_store")
  @@map("customer_segments")
}

enum EmailCampaignStatus {
  queued
  sending
  sent
  failed
}

// Module 34 (SRS §5.51/§14.51) - a basic campaign/newsletter sent to
// exactly one saved segment (§5.50) via the seller's OWN connected SMTP
// sender (Module 26's SellerVerificationEmail - reused as-is, FR-51.1, no
// second credential store). Sends run as a background job (FR-51.6);
// recipientCount/sentCount/failedCount are the truth about what happened,
// not an assumption from the segment's size at creation time (membership
// is re-derived live when the job actually runs, same discipline as
// Customer Segments itself).
model EmailCampaign {
  id             String              @id @default(uuid()) @db.Uuid
  storeId        String              @map("store_id") @db.Uuid
  segmentId      String              @map("segment_id") @db.Uuid
  senderEmailId  String              @map("sender_email_id") @db.Uuid
  subject        String
  body           String
  status         EmailCampaignStatus @default(queued)
  recipientCount Int                 @default(0) @map("recipient_count")
  sentCount      Int                 @default(0) @map("sent_count")
  failedCount    Int                 @default(0) @map("failed_count")
  failureReason  String?             @map("failure_reason")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz

  store       Store                   @relation(fields: [storeId], references: [id])
  segment     CustomerSegment         @relation(fields: [segmentId], references: [id])
  senderEmail SellerVerificationEmail @relation(fields: [senderEmailId], references: [id])

  @@index([storeId, createdAt], name: "idx_email_campaigns_store_created")
  @@map("email_campaigns")
}

enum PlatformNewsletterStatus {
  draft
  sending
  sent
  failed
}

// Module 55 (SRS §5.62/FR-62.2) - the admin-composed platform newsletter.
// Deliberately NOT store-scoped (no storeId, no RLS) - this is a
// platform-wide broadcast to every seller, sent from UZEYN's own SMTP
// identity (EmailService, the same one every other platform email already
// uses), never a seller's connected mailbox - a materially different
// audience/sender pair from EmailCampaign above despite the similar shape.
model PlatformNewsletter {
  id               String                   @id @default(uuid()) @db.Uuid
  subject          String
  body             String
  status           PlatformNewsletterStatus @default(draft)
  createdByAdminId String                   @map("created_by_admin_id") @db.Uuid
  recipientCount   Int                      @default(0) @map("recipient_count")
  sentCount        Int                      @default(0) @map("sent_count")
  failedCount      Int                      @default(0) @map("failed_count")
  failureReason    String?                  @map("failure_reason")
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  sentAt           DateTime?                @map("sent_at") @db.Timestamptz

  createdByAdmin AdminUser @relation(fields: [createdByAdminId], references: [id])

  @@index([createdAt], name: "idx_platform_newsletters_created")
  @@map("platform_newsletters")
}

enum ReviewStatus {
  pending
  approved
  hidden
  // SRS §5.14/FR-14.6 (Module 93) - a harder, one-way action from a
  // seller's perspective (no "undelete" surfaced anywhere), distinct from
  // `hidden` which stays freely reversible. Soft, not physical - the row,
  // deletedAt, and deletedReason below all persist for the audit trail.
  deleted
}

// Module 15 (FR-14.1-14.4) - submitted via the order-status link (FR-5.4),
// never an account. `productId`/`orderId` denormalize `storeId` for RLS,
// same pattern as every other tenant table.
model ProductReview {
  id                 String       @id @default(uuid()) @db.Uuid
  storeId            String       @map("store_id") @db.Uuid
  productId          String       @map("product_id") @db.Uuid
  orderId            String?      @map("order_id") @db.Uuid
  buyerName          String       @map("buyer_name")
  buyerEmail         String       @map("buyer_email")
  rating             Int
  body               String
  isVerifiedPurchase Boolean      @default(false) @map("is_verified_purchase")
  status             ReviewStatus @default(pending)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  // SRS §5.14/FR-14.6 (Module 93) - set together, only when status becomes
  // `deleted`. Kept directly on the row (rather than requiring a join to
  // the Platform Event Log, which also records this action) so the detail
  // view (FR-14.5) can render them with no extra query.
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz
  deletedReason String?   @map("deleted_reason")

  product Product       @relation(fields: [productId], references: [id])
  order   Order?        @relation(fields: [orderId], references: [id])
  media   ReviewMedia[]

  @@index([productId, status], name: "idx_reviews_product_status")
  @@index([storeId, status], name: "idx_reviews_store_status")
  @@map("product_reviews")
}

/// Phase 4 close-out - the buyer-experience-batch capability the original
/// audit found genuinely missing end-to-end (no columns, no upload path).
/// A separate table rather than columns on ProductReview itself, since a
/// review can carry several attachments (unlike the single-cover-image
/// shape elsewhere) - same one-review-to-many-assets shape as
/// Product/MediaAsset. Reuses the existing `MediaType` enum (image/video)
/// rather than a parallel "photo"/"video" naming.
model ReviewMedia {
  id        String    @id @default(uuid()) @db.Uuid
  // Denormalized from the parent review, same "every RLS'd table resolves
  // tenant isolation via its own direct store_id column, never a two-hop
  // join" convention every other table here already follows (see
  // product_reviews_seller_isolation for the one-hop precedent this
  // mirrors).
  storeId   String    @map("store_id") @db.Uuid
  reviewId  String    @map("review_id") @db.Uuid
  type      MediaType
  url       String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  review ProductReview @relation(fields: [reviewId], references: [id])

  @@index([reviewId], name: "idx_review_media_review")
  @@map("review_media")
}

enum ImportJobType {
  product_import
  product_export
  order_export
  // Module 28 (SRS §5.39/FR-39.3) - a bulk stock-quantity-only edit,
  // reusing this same job/error-report machinery in a narrower mode
  // (SKU + new quantity columns only, never touching price/title/etc.).
  stock_import
  // Module 31 (SRS §5.42/FR-42.1) - CSV ad-spend import, same job/error-
  // report machinery in a third narrow mode (PeriodStart/PeriodEnd/Amount
  // columns only, creating AdSpendEntry rows).
  ad_spend_import
  // Module 52 (SRS §5.59/FR-59.3(a)) - the CSV tracking-entry path, same
  // job/error-report machinery in a fourth narrow mode (OrderNumber/
  // Courier/TrackingId columns only), applying each row's courier/tracking
  // to every not-yet-shipped item on the matched order via the same
  // OrdersService.uploadTrackingForOrder() the inline quick-entry path
  // (FR-59.3(b)) also calls.
  tracking_import
}

enum ImportJobStatus {
  pending
  processing
  completed
  failed
}

// Module 15 (FR-18.1-18.3) - a single tracked-job table for all three CSV
// operations, per docs/database-schema.md's pre-documented spec.
model ImportJob {
  id             String          @id @default(uuid()) @db.Uuid
  storeId        String          @map("store_id") @db.Uuid
  type           ImportJobType
  status         ImportJobStatus @default(pending)
  // Source CSV (import) or generated output (export), stored in MinIO.
  fileUrl        String          @map("file_url")
  // FR-18.1 - the CSV columns present in the uploaded file that were not
  // mapped to a core field, surfaced to the seller explicitly per upload.
  unmappedFields String[]        @default([]) @map("unmapped_fields")
  // FR-18.2 - per-row errors for `product_import`; a bad row never fails
  // the whole import.
  errorLog       Json?           @map("error_log")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?       @map("completed_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, status], name: "idx_import_jobs_store_status")
  @@map("import_jobs")
}

enum AdSpendSource {
  manual
  csv_import
}

// Module 31 (SRS §5.42/FR-42.1/FR-42.3/FR-42.6) - ad-spend entries scoped
// to a date period, netted against revenue in PnLService's per-period
// aggregation. `source` is a documented extension seam (FR-42.6/42.7): a
// future automated Facebook/TikTok Ads API sync would write rows here with
// a new source value through this same table and period-aggregation
// logic - never a second, parallel ad-spend concept.
model AdSpendEntry {
  id          String        @id @default(uuid()) @db.Uuid
  storeId     String        @map("store_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Date
  periodEnd   DateTime      @map("period_end") @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  source      AdSpendSource @default(manual)
  note        String?
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, periodStart, periodEnd], name: "idx_ad_spend_store_period")
  @@map("ad_spend_entries")
}

// Module 9 clarification: `created_at` is a genuine addition to the
// documented schema (docs/database-schema.md's own table def omitted it,
// but its supplier-tracking index - `(supplier_id, fulfillment_status,
// created_at)` - requires the column to exist; same "every other table has
// it" reasoning already applied to the `Domain` table in Module 3).
model OrderItem {
  id                String                     @id @default(uuid()) @db.Uuid
  storeId           String                     @map("store_id") @db.Uuid
  orderId           String                     @map("order_id") @db.Uuid
  productId         String                     @map("product_id") @db.Uuid
  variantId         String                     @map("variant_id") @db.Uuid
  supplierId        String?                    @map("supplier_id") @db.Uuid
  quantity          Int
  unitPrice         Decimal                    @map("unit_price") @db.Decimal(12, 2)
  shippingCost      Decimal                    @map("shipping_cost") @db.Decimal(12, 2)
  fulfillmentStatus OrderItemFulfillmentStatus @default(pending) @map("fulfillment_status")
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  order           Order            @relation(fields: [orderId], references: [id])
  product         Product          @relation(fields: [productId], references: [id])
  variant         ProductVariant   @relation(fields: [variantId], references: [id])
  trackingUpdates TrackingUpdate[]

  @@index([supplierId, fulfillmentStatus, createdAt], name: "idx_order_items_supplier_status")
  @@index([orderId], name: "idx_order_items_order_id")
  @@map("order_items")
}

enum OrderVerificationChannel {
  whatsapp_otp
  email_otp
  prepaid_confirmation
  prepaid_partial_advance
}

enum OrderVerificationStatus {
  pending
  verified
  failed
  expired
}

// Module 26 (SRS §5.37, FR-37.1-37.8) - one row per order placed against a
// store with orders.verification_channel != "none". `channel` is a snapshot
// of the store's setting at order-placement time - a seller changing
// channels later never rewrites an in-flight verification's history.
// Extends (never duplicates) the Financial Truth Invariant (§3.12): the
// order-confirmation path checks this row's status the same way it already
// checks payment - one additional gate, not a second "confirmed" concept.
model OrderVerification {
  id            String                   @id @default(uuid()) @db.Uuid
  // Denormalized from the order at creation time - same "every tenant-
  // scoped child table carries its own store_id for RLS" convention as
  // order_notes/order_timeline_events/tracking_updates, not a join-through-
  // order policy.
  storeId       String                   @map("store_id") @db.Uuid
  orderId       String                   @unique @map("order_id") @db.Uuid
  channel       OrderVerificationChannel
  status        OrderVerificationStatus  @default(pending)
  // Hashed, never plaintext (FR-37.5) - null for prepaid_confirmation,
  // which has no OTP at all.
  otpHash       String?                  @map("otp_hash")
  otpExpiresAt  DateTime?                @map("otp_expires_at") @db.Timestamptz
  attemptCount  Int                      @default(0) @map("attempt_count")
  // Which connected sender rotation picked for this OTP (email_otp only) -
  // the actual rotation-decision record, not just a convenience FK.
  senderEmailId String?                  @map("sender_email_id") @db.Uuid
  verifiedAt    DateTime?                @map("verified_at") @db.Timestamptz
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  store       Store                    @relation(fields: [storeId], references: [id])
  order       Order                    @relation(fields: [orderId], references: [id])
  senderEmail SellerVerificationEmail? @relation(fields: [senderEmailId], references: [id])

  @@map("order_verifications")
}

enum SellerVerificationEmailStatus {
  active
  revoked
}

// Module 26 (SRS §5.37, FR-37.3) - a seller's own connected SMTP sender
// account for the Email OTP channel. 1-5 rows per seller (app-layer
// enforced - a small fixed-range limit, same precedent as elsewhere in
// this schema rather than a DB constraint). Credentials are encrypted at
// rest under SMTP_CREDENTIAL_ENCRYPTION_KEY, packed iv:authTag:ciphertext -
// identical format to google_drive_connections.refresh_token_encrypted,
// but its own independently-rotatable key.
model SellerVerificationEmail {
  id                    String                        @id @default(uuid()) @db.Uuid
  sellerId              String                        @map("seller_id") @db.Uuid
  emailAddress          String                        @map("email_address")
  smtpHost              String                        @map("smtp_host")
  smtpPort              Int                           @map("smtp_port")
  smtpUsername          String                        @map("smtp_username")
  smtpPasswordEncrypted String                        @map("smtp_password_encrypted")
  dailySendCount        Int                           @default(0) @map("daily_send_count")
  dailySendCountResetAt DateTime                      @default(now()) @map("daily_send_count_reset_at") @db.Timestamptz
  status                SellerVerificationEmailStatus @default(active)
  connectedAt           DateTime                      @default(now()) @map("connected_at") @db.Timestamptz

  seller        Seller              @relation(fields: [sellerId], references: [id])
  verifications OrderVerification[]
  campaigns     EmailCampaign[]

  @@index([sellerId, status], name: "idx_seller_verification_emails_seller_status")
  @@map("seller_verification_emails")
}

enum StaffScope {
  orders
  catalog
  discounts
  customers
  design
}

enum StaffAccountStatus {
  active
  revoked
}

// Module 35 (SRS §5.52/FR-52.1-52.6) - pulls the previously Phase-3-deferred
// staff-sub-account concept forward as a plan-tier differentiator. Seller-
// owned, deliberately seller-scoped only (no store_id, no RLS policy) -
// same "no RLS, explicit sellerId filter via PrismaAdminService" discipline
// as SellerVerificationEmail above, since a staff account's access spans
// all of the owner's stores, not one. `billing`/`payment-instructions`/
// `wallet`/`plan` are never assignable scopes - owner-only always,
// enforced app-side (StaffScopeGuard has no metadata value that maps to
// them, so no route can be opted into checking for them as a staff-
// satisfiable scope).
model StaffAccount {
  id           String             @id @default(uuid()) @db.Uuid
  sellerId     String             @map("seller_id") @db.Uuid
  email        String             @unique
  passwordHash String             @map("password_hash")
  name         String?
  scopes       StaffScope[]
  status       StaffAccountStatus @default(active)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId], name: "idx_staff_accounts_seller")
  @@map("staff_accounts")
}

// Module 36 (SRS §5.53/FR-53.1-53.5) - UZEYN's own unified inbox in the
// admin terminal. Admin-global, not tenant-scoped - same "no RLS, gated by
// AdminAuthGuard, inherently precedes tenant context" category as
// AdminAuditLog/ImpersonationSession, since this is the founder's own
// inbox, not a seller-facing feature. IMAP+SMTP credentials are encrypted
// at rest under their own independent ADMIN_EMAIL_CREDENTIAL_ENCRYPTION_KEY
// (same AES-256-GCM shape as smtp-credential-crypto.util.ts, kept as its
// own key so it rotates independently of the seller-facing SMTP secret).
model AdminEmailAccount {
  id                    String   @id @default(uuid()) @db.Uuid
  emailAddress          String   @unique @map("email_address")
  displayName           String?  @map("display_name")
  imapHost              String   @map("imap_host")
  imapPort              Int      @map("imap_port")
  imapUseTls            Boolean  @default(true) @map("imap_use_tls")
  imapUsername          String   @map("imap_username")
  imapPasswordEncrypted String   @map("imap_password_encrypted")
  smtpHost              String   @map("smtp_host")
  smtpPort              Int      @map("smtp_port")
  smtpUseTls            Boolean  @default(false) @map("smtp_use_tls")
  smtpUsername          String   @map("smtp_username")
  smtpPasswordEncrypted String   @map("smtp_password_encrypted")
  linkedByAdminUserId   String?  @map("linked_by_admin_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  linkedByAdminUser AdminUser? @relation(fields: [linkedByAdminUserId], references: [id])

  @@map("admin_email_accounts")
}

// Module 28 (SRS §5.39, FR-39.4) - append-only stock-change history, seller-
// facing tier equivalent of admin_audit_logs' immutability (no UPDATE/DELETE
// grant for app_runtime on this table).
model StockAdjustment {
  id               String   @id @default(uuid()) @db.Uuid
  storeId          String   @map("store_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  adjustedByUserId String   @map("adjusted_by_user_id") @db.Uuid
  quantityBefore   Int      @map("quantity_before")
  quantityAfter    Int      @map("quantity_after")
  reason           String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  store   Store          @relation(fields: [storeId], references: [id])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([storeId, createdAt], name: "idx_stock_adjustments_store_created")
  @@index([productVariantId], name: "idx_stock_adjustments_variant")
  @@map("stock_adjustments")
}

// FR-17.2 - never surfaced on any buyer-facing query.
model OrderNote {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId], name: "idx_order_notes_order")
  @@map("order_notes")
}

// FR-17.4 - append-only; `beforeValue`/`afterValue` follow the same
// discipline as `admin_audit_logs` for `edited` events.
model OrderTimelineEvent {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  eventType   String   @map("event_type")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt], name: "idx_order_timeline_order_created")
  @@map("order_timeline_events")
}

// Module 9 clarification: `store_id` is a genuine addition to the
// documented schema - every other tenant-child table gets it denormalized
// for RLS per docs/database-schema.md's own tenant-strategy rule; this
// table's documented definition omitted it, which would leave it as the
// one tenant-adjacent table with no RLS policy of its own.
model TrackingUpdate {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  orderItemId String   @map("order_item_id") @db.Uuid
  trackingId  String   @map("tracking_id")
  carrier     String?
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  uploadedAt  DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId], name: "idx_tracking_order_item")
  @@map("tracking_updates")
}

// FR-17.1 - `manual` is this module's only writer (mark-as-paid). Real
// gateway integration (Safepay webhook -> `succeeded` payment) is Module
// 10/11's job; the enum/table exist now so that module extends this,
// rather than introduces a competing payment record shape.
model Payment {
  id                   String         @id @default(uuid()) @db.Uuid
  storeId              String         @map("store_id") @db.Uuid
  orderId              String         @map("order_id") @db.Uuid
  gateway              PaymentGateway
  gatewayTransactionId String?        @unique @map("gateway_transaction_id")
  amount               Decimal        @db.Decimal(12, 2)
  currency             String
  status               PaymentStatus
  rawWebhookPayload    Json?          @map("raw_webhook_payload")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// Module 11 (Commission & Invoicing Engine, SRS §5.6c). `commission_accrued`/
// `commission_waived` are the only types v1.0 code ever writes - every other
// value is the dormant Platform-Collected mode's (§5.6d), retained verbatim
// for its own eventual reactivation, per docs/database-schema.md's own note.
enum LedgerEntryType {
  sale_credit
  commission_debit
  gateway_fee_debit
  hold_release
  reserve_hold
  reserve_release
  payout_debit
  refund_adjustment
  commission_accrued
  commission_waived
  // Module 20 (SRS §5.6e, FR-6.21/6.23/6.24) - the wallet's own entry
  // types, on the same table per the founder's explicit "extends...
  // existing commission debits" instruction. commission_accrued/
  // commission_waived are unchanged and reused as-is for the commission
  // debit/waiver side of the wallet - only these four are new.
  wallet_topup_credit
  wallet_plan_fee_debit
  wallet_team_seat_fee_debit
  wallet_device_slot_fee_debit
  // Module 22 (SRS §5.33/FR-33.9) - Growth & Partner Programs' earnings on
  // the same wallet/ledger, never a parallel one. `payout_debit` above was
  // reserved-but-unused since the original schema (SRS §5.6b, dormant) -
  // this module is its first real writer, the moment a withdrawal is
  // marked Paid (PayoutRequest, below).
  program_commission_credit
  program_reward_credit
  program_clawback_debit
  // Module 23 (SRS §5.35/FR-35.2/35.3) - the Verified Store Program's
  // application-processing fee (never a purchase of the badge itself, see
  // the FR's own binding framing) and its full refund on an admin reject,
  // same clawback/refund-credit mechanism already established by Module 22.
  verification_fee_debit
  verification_fee_refund_credit
  // Module 25 (Admin Completion, SRS Admin Control Plane) - the seller-360
  // page's "adjust wallet" inline action. A manual, admin-initiated,
  // reason-required correction (goodwill credit, error correction) -
  // never system-generated, always audit-logged with the reason attached
  // to the audit entry (the ledger row itself has no reason column, same
  // as every other entry type here).
  admin_manual_credit
  admin_manual_debit
}

model LedgerEntry {
  id               String          @id @default(uuid()) @db.Uuid
  sellerId         String          @map("seller_id") @db.Uuid
  orderId          String?         @map("order_id") @db.Uuid
  invoiceId        String?         @map("invoice_id") @db.Uuid
  type             LedgerEntryType
  // Always stored as a positive magnitude except commission_waived and
  // refund_adjustment (both kept negative - waiveCommission()'s original
  // Module 11 convention, extended by Module 53's reverseCommissionForRefund()
  // to the second reserved-since-v1.0 entry type). WalletService.getBalance()
  // (Module 20) is the one place that maps entry type to a +/- sign when
  // computing a balance; every debit type (commission_accrued,
  // wallet_*_fee_debit) subtracts, wallet_topup_credit adds, and
  // commission_waived/refund_adjustment's already-negative amount adds back
  // (a waiver or refund reversal increases the balance). Nothing else
  // computes a balance from this table directly.
  amount           Decimal         @db.Decimal(12, 2)
  currency         String
  balanceBucket    BalanceBucket?  @map("balance_bucket")
  holdReleaseAt    DateTime?       @map("hold_release_at") @db.Timestamptz
  reserveReleaseAt DateTime?       @map("reserve_release_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz

  seller  Seller         @relation(fields: [sellerId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])
  invoice SellerInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([sellerId, createdAt], name: "idx_ledger_seller_created")
  @@map("ledger_entries")
}

// Module 47 (SRS §5.6e, FR-6.21 amended v0.33) - the ledger stays the
// append-only source of truth; this is its verified, race-free running-
// total cache, one row per seller, updated atomically (via Prisma's
// `increment`/`decrement`) in the SAME transaction as every LedgerEntry
// insert - see WalletService.postLedgerEntry(), the ONE function that
// writes a wallet-relevant LedgerEntry, so this column can never drift
// from a write path that forgets to update it. `balance` can legitimately
// go negative (commission always accrues; the negative-float floor pauses
// stores AFTER the fact, it never blocks the debit itself - FR-6.26).
model WalletBalance {
  sellerId  String   @id @map("seller_id") @db.Uuid
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@map("wallet_balances")
}

// Module 47 (new FR-6.29) - the daily reconciliation job's append-only
// findings log. A detected mismatch is NEVER auto-corrected here (the
// founder's explicit requirement) - only recorded, for admin review via
// the notification center; the drift itself is fixed by a human, not by
// this table.
model WalletReconciliationDrift {
  id            String   @id @default(uuid()) @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  cachedBalance Decimal  @map("cached_balance") @db.Decimal(12, 2)
  ledgerBalance Decimal  @map("ledger_balance") @db.Decimal(12, 2)
  driftAmount   Decimal  @map("drift_amount") @db.Decimal(12, 2)
  detectedAt    DateTime @default(now()) @map("detected_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([detectedAt])
  @@map("wallet_reconciliation_drifts")
}

enum BalanceBucket {
  pending
  available
  reserved
}

// Module 22 (SRS §5.33, FR-33.2-33.12) - Growth & Partner Programs.
// Phase A: the shared referral engine (Ambassador/Student Referral/
// Creators). Careers (FR-33.8, Phase B) has no referral/commission
// machinery and gets its own models when that phase is built.

enum ReferralProgramType {
  ambassador
  student_referral
  creator
}

// FR-33.2 - the one shape every program's application/approval/suspension
// lifecycle follows. `rejected` and `terminated` are both terminal but
// distinct: `rejected` is a decision on the original application (before
// ever being approved); `terminated` is an admin ending an
// already-`approved` participant's access (FR-33.2's "at any time, for
// Terms violation, fraud, or suspicious activity").
enum ProgramParticipantStatus {
  pending
  approved
  rejected
  suspended
  terminated
}

enum ContentPlatform {
  tiktok
  instagram
  youtube
  snapchat
  facebook
  x
  pinterest
}

// FR-33.7 - a view count alone never triggers payout; this is the
// mandatory manual-verification gate's own state.
enum ContentSubmissionStatus {
  pending
  verified
  rejected
}

// SRS §5.6b (dormant) / FR-33.9 - reactivated by this module. Money only
// actually leaves the platform (a `payout_debit` ledger entry) at `paid` -
// every earlier state is reversible with zero ledger impact.
enum PayoutRequestStatus {
  requested
  approved
  processing
  paid
  rejected
}

/// FR-33.2/33.5/33.6/33.7 - one row per seller per program; a seller may
/// hold participation in more than one distinct program, but never apply
/// to the same program twice (@@unique below). No self-serve join: every
/// row starts `pending` and only an admin decision moves it to
/// `approved`/`rejected`; `referralCode` is issued only on approval - an
/// application that was never approved has nothing to give out.
model ProgramParticipant {
  id                   String                   @id @default(uuid()) @db.Uuid
  sellerId             String                   @map("seller_id") @db.Uuid
  programType          ReferralProgramType      @map("program_type")
  status               ProgramParticipantStatus @default(pending)
  referralCode         String?                  @unique @map("referral_code")
  appliedAt            DateTime                 @default(now()) @map("applied_at") @db.Timestamptz
  decidedAt            DateTime?                @map("decided_at") @db.Timestamptz
  decidedByAdminUserId String?                  @map("decided_by_admin_user_id") @db.Uuid
  decisionNotes        String?                  @map("decision_notes")
  // Module 79 (SRS §5.33, FR-33.6 pre-Module-78-numbering / "Ambassador
  // Program repricing") - how many of this ambassador's OWN stores are
  // plan-fee-exempt (PlanFeeDebitService/ProgramCommissionService). Set
  // from growth.ambassador_free_store_slots at approval time (same
  // "issued only at approval" precedent as referralCode), admin-editable
  // afterward. Null/unset for every non-ambassador participant - never
  // meaningful for student_referral/creator.
  freeStoreSlotsGranted Int?                     @map("free_store_slots_granted")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  seller       Seller                     @relation(fields: [sellerId], references: [id])
  attributions ReferralAttribution[]
  submissions  ProgramContentSubmission[]

  @@unique([sellerId, programType], name: "uniq_program_participant_seller_program")
  @@map("program_participants")
}

/// FR-33.3 - single-referral-source-per-seller, enforced at the DATA-MODEL
/// level (the @@unique on referredSellerId below), not merely application
/// logic: the first valid attribution across any program wins and is
/// written once; a second attempt for the same referred seller cannot
/// create a second row, full stop.
model ReferralAttribution {
  id String @id @default(uuid()) @db.Uuid

  referredSellerId       String              @unique @map("referred_seller_id") @db.Uuid
  participantId          String              @map("participant_id") @db.Uuid
  // Denormalized from participant.programType at attribution time - stable
  // even if the participant's own row is later suspended/terminated (a
  // suspended participant's PAST attributions/window are unaffected;
  // ProgramCommissionService blocks only NEW accrual while suspended).
  programType            ReferralProgramType @map("program_type")
  // FR-33.5/33.6/33.7 - the commission window is locked in using whichever
  // Settings Registry window value was in effect AT ATTRIBUTION TIME. A
  // later admin change to the window setting must never retroactively
  // shorten or lengthen an attribution already in flight.
  commissionWindowEndsAt DateTime            @map("commission_window_ends_at") @db.Timestamptz
  attributedAt           DateTime            @default(now()) @map("attributed_at") @db.Timestamptz
  // Module 78 (SRS §5.33, FR-33.5) - Student Referral's flat-per-renewal
  // commission (replacing its old percent-of-plan-fee model) is capped by
  // COUNT ("up to 2 renewal cycles"), not the time-based
  // commissionWindowEndsAt above (Ambassador/Creator still use that field
  // for their own unchanged cap). Incremented only when a Student Referral
  // renewal commission is actually paid; unused by ambassador/creator.
  renewalPayoutCount     Int                 @default(0) @map("renewal_payout_count")
  // Module 79 (FR-33.6 pre-Module-78-numbering / "Ambassador Program
  // repricing") - Ambassador's own count-based cap, in MONTHS rather than
  // renewal-events (a single renewal payment can cover 1/6/12 months
  // depending on the referred seller's billing cycle, pro-rated against
  // the remaining cap) - a distinct field from renewalPayoutCount above,
  // which counts discrete Student Referral renewal events, not months.
  // Unused by student_referral/creator.
  commissionMonthsPaid   Int                 @default(0) @map("commission_months_paid")

  participant    ProgramParticipant @relation(fields: [participantId], references: [id])
  referredSeller Seller             @relation("ReferralAttributionReferred", fields: [referredSellerId], references: [id])

  @@map("referral_attributions")
}

/// FR-33.7 - Creators' manual content-verification queue. `reportedViews`
/// is a signal only; `rewardAmount` is computed and frozen the moment an
/// admin verifies (never recomputed later even if reportedViews changes -
/// there is no edit path for a submission after creation).
model ProgramContentSubmission {
  id                    String                  @id @default(uuid()) @db.Uuid
  participantId         String                  @map("participant_id") @db.Uuid
  platform              ContentPlatform
  contentUrl            String                  @map("content_url")
  reportedViews         Int                     @map("reported_views")
  status                ContentSubmissionStatus @default(pending)
  rewardAmount          Decimal?                @map("reward_amount") @db.Decimal(12, 2)
  verifiedByAdminUserId String?                 @map("verified_by_admin_user_id") @db.Uuid
  verifiedAt            DateTime?               @map("verified_at") @db.Timestamptz
  notes                 String?
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz

  participant ProgramParticipant @relation(fields: [participantId], references: [id])

  @@map("program_content_submissions")
}

// Module 22 Phase B (SRS §5.33, FR-33.8) - Careers. No referral/commission/
// wallet machinery, fully independent of Phase A's models above. Reuses
// FR-12.1's "versioned admin-editable content, not a new CMS" DISCIPLINE
// (admin-managed, not seller-managed, public reads for `open` only) -
// not literally the same `ContentPage` table, since a job posting needs
// its own status/application-pipeline shape `ContentPage` doesn't have.

enum JobPostingStatus {
  draft
  open
  closed
}

model JobPosting {
  id          String           @id @default(uuid()) @db.Uuid
  role        String
  description String
  status      JobPostingStatus @default(draft)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  applications JobApplication[]

  @@map("job_postings")
}

// FR-33.8 - "status tracking (received -> reviewing -> interviewing ->
// rejected/hired - Settings-Registry-editable LABELS, not hard-coded
// English strings, matching FR-33.5's tier-naming discipline)." The enum
// below is the fixed internal state machine (needed for real transition
// logic); `careers.application_stage_labels` (Settings Registry, JSON) is
// the admin-editable DISPLAY text for each of these five fixed values -
// same "internal code stays fixed, outward text is data" split FR-33.5's
// certificate tiers already established.
enum JobApplicationStatus {
  received
  reviewing
  interviewing
  rejected
  hired
}

// Applicant data (contact details, CV) is never exposed on any public
// endpoint (FR-33.8, same access discipline as customer PII, §5.13) -
// enforced by this model having no public-facing read path at all in
// `careers.controller.ts`; only `admin-careers.controller.ts` (behind
// `AdminAuthGuard`) ever queries this table.
model JobApplication {
  id             String               @id @default(uuid()) @db.Uuid
  jobPostingId   String               @map("job_posting_id") @db.Uuid
  applicantName  String               @map("applicant_name")
  applicantEmail String               @map("applicant_email")
  applicantPhone String?              @map("applicant_phone")
  // The object-storage substrate (§3.3), same as every other upload path
  // in this SRS - a dedicated size/type limit for documents, enforced at
  // the controller (careers.controller.ts), not this schema.
  cvUrl          String               @map("cv_url")
  status         JobApplicationStatus @default(received)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id])

  @@index([jobPostingId, status], name: "idx_job_applications_posting_status")
  @@map("job_applications")
}

// Module 23 (SRS §5.34, FR-34.2) - one row per scheduled recompute run, so
// the seller dashboard can render a trend, not just the latest value.
// `breakdown` is a JSON array of per-input {key, weight, fraction,
// contribution, note?} - the exact same numbers the plain-language
// dashboard breakdown (FR-34.3) is derived from, kept alongside the score
// itself rather than re-derived on every read.
model StoreHealthScoreHistory {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  score      Int
  breakdown  Json
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, computedAt], name: "idx_store_health_history_store_computed")
  @@map("store_health_score_history")
}

enum VerifiedStoreApplicationStatus {
  pending_review
  approved
  rejected
}

// Module 23 (SRS §5.35, FR-35.2/35.3) - one row per application (including
// each annual re-verification re-application, FR-35.6 - never a rubber-
// stamp renewal, so it goes through this exact same queue again).
// `eligibilitySnapshot` freezes the criteria pass/fail picture the
// reviewer saw at decision time (health score, tenure, CNIC, T&S, sales
// volume) so a later change to Settings Registry thresholds never rewrites
// the historical record of what was actually reviewed. Distinct from
// `Store.verifiedStatus`/`reReviewFlaggedAt` (the store's current live
// badge state) - a drift-triggered re-review flag (FR-35.5) is resolved
// directly on the Store, without a new row here, since no fee is charged
// and no fresh eligibility application was submitted.
model VerifiedStoreApplication {
  id                  String                         @id @default(uuid()) @db.Uuid
  storeId             String                         @map("store_id") @db.Uuid
  sellerId            String                         @map("seller_id") @db.Uuid
  status              VerifiedStoreApplicationStatus @default(pending_review)
  feeAmount           Decimal                        @map("fee_amount") @db.Decimal(12, 2)
  currency            String
  eligibilitySnapshot Json                           @map("eligibility_snapshot")
  decidedBy           String?                        @map("decided_by") @db.Uuid
  decidedAt           DateTime?                      @map("decided_at") @db.Timestamptz
  decisionNotes       String?                        @map("decision_notes")
  createdAt           DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  store          Store      @relation(fields: [storeId], references: [id])
  seller         Seller     @relation(fields: [sellerId], references: [id])
  decidedByAdmin AdminUser? @relation(fields: [decidedBy], references: [id])

  @@index([status, createdAt], name: "idx_verified_store_app_status_created")
  @@map("verified_store_applications")
}

enum DataExportTrigger {
  subscription_renewal
  on_demand
}

enum DataExportStatus {
  pending
  completed
  failed
}

enum DataExportDeliveryMethod {
  drive
  email
}

// Module 24 (SRS §5.36, FR-36.1-36.5) - one row per export run, across ALL
// of a seller's stores (the trigger - subscription renewal - is per-seller,
// `Subscription.sellerId` is unique, so the bundle is seller-scoped, not
// store-scoped, same category as `ProgramParticipant`/`PayoutRequest`: no
// RLS policy of its own, accessed via `PrismaAdminService` + explicit
// sellerId filtering). `periodStart` is the previous completed export's
// `periodEnd` (or the seller's own `createdAt` for a first-ever export),
// giving FR-36.2's "scoped to the period since the last export" without a
// separate cursor field. This same table's most recent row (any trigger)
// is also what FR-36.1(b)'s on-demand rate limit is checked against.
// v0.28 security fix: the *CsvKey/*PdfKey columns are internal
// ObjectStorageService keys (under a non-public "private/" prefix), never
// public URLs - they must never be returned to any client. The only access
// path is the ownership-checked `GET .../download/:file` streaming
// endpoint (FR-36.3, revised).
model SellerDataExport {
  id              String                    @id @default(uuid()) @db.Uuid
  sellerId        String                    @map("seller_id") @db.Uuid
  trigger         DataExportTrigger
  status          DataExportStatus          @default(pending)
  deliveryMethod  DataExportDeliveryMethod? @map("delivery_method")
  periodStart     DateTime                  @map("period_start") @db.Timestamptz
  periodEnd       DateTime                  @map("period_end") @db.Timestamptz
  productsCsvKey  String?                   @map("products_csv_key")
  ordersCsvKey    String?                   @map("orders_csv_key")
  customersCsvKey String?                   @map("customers_csv_key")
  // Module 28 (SRS §5.39/FR-39.6) - current stock levels across the
  // seller's products/variants, delivered through the exact same private
  // download path as every other artifact here (FR-36.5's non-substitution
  // statement applies unchanged).
  inventoryCsvKey String?                   @map("inventory_csv_key")
  summaryPdfKey   String?                   @map("summary_pdf_key")
  failureReason   String?                   @map("failure_reason")
  createdAt       DateTime                  @default(now()) @map("created_at") @db.Timestamptz
  completedAt     DateTime?                 @map("completed_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, createdAt], name: "idx_seller_data_exports_seller_created")
  @@map("seller_data_exports")
}

/// SRS §5.6b, reactivated by Module 22 (FR-33.9) - the Payout Request &
/// Disbursement Engine's first real implementation, scoped in v1.0 to
/// Growth & Partner Programs earnings (the only source of a genuinely
/// POSITIVE wallet balance today - commission is money a seller OWES the
/// platform, not the reverse, per the Direct Seller Collection pivot,
/// §5.29). Requesting/approving never touches the ledger - only a
/// transition to `paid` creates the actual `payout_debit` entry, so a
/// rejected request needs no ledger reversal; the balance was never
/// touched in the first place.
model PayoutRequest {
  id                   String              @id @default(uuid()) @db.Uuid
  sellerId             String              @map("seller_id") @db.Uuid
  amount               Decimal             @db.Decimal(12, 2)
  currency             String              @default("PKR")
  status               PayoutRequestStatus @default(requested)
  requestedAt          DateTime            @default(now()) @map("requested_at") @db.Timestamptz
  decidedByAdminUserId String?             @map("decided_by_admin_user_id") @db.Uuid
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz
  decisionNotes        String?             @map("decision_notes")
  // FR-6.11 - the manual disbursement adapter's own reference (e.g. a bank
  // transfer reference number), set when marked Paid.
  paymentReference     String?             @map("payment_reference")
  paidAt               DateTime?           @map("paid_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status], name: "idx_payout_requests_seller_status")
  @@map("payout_requests")
}

enum InvoiceStatus {
  pending
  paid
  overdue
}

model SellerInvoice {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @map("seller_id") @db.Uuid
  // Module 14 (FR-7.15/7.18) - which kind of invoice this is. For
  // `group_sponsorship`, sellerId is the LEADER's id (they're billed, not
  // any member) and teamId identifies which team. Default `commission`
  // preserves every pre-Module-14 row's meaning unchanged.
  invoiceType InvoiceType   @default(commission) @map("invoice_type")
  teamId      String?       @map("team_id") @db.Uuid
  periodStart DateTime      @map("period_start") @db.Timestamptz
  periodEnd   DateTime      @map("period_end") @db.Timestamptz
  // A snapshot at generation time (sum of that period's commission_accrued/
  // commission_waived entries) - a later ledger entry never silently
  // changes an already-generated invoice.
  totalAmount Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency    String
  status      InvoiceStatus @default(pending)
  dueDate     DateTime      @map("due_date") @db.Timestamptz
  paidAt      DateTime?     @map("paid_at") @db.Timestamptz
  paidBy      String?       @map("paid_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  seller        Seller        @relation(fields: [sellerId], references: [id])
  team          Team?         @relation(fields: [teamId], references: [id])
  paidByAdmin   AdminUser?    @relation(fields: [paidBy], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([sellerId, status], name: "idx_seller_invoices_seller_status")
  @@index([status, dueDate], name: "idx_seller_invoices_overdue_check")
  @@map("seller_invoices")
}

// Module 20 (SRS §5.6e, FR-6.23). Shared by both the seller wallet and the
// supplier wallet (ownerType/ownerId rather than two near-identical tables)
// - a top-up request's shape (amount, manual-verification workflow) is
// identical for both; only which ledger the resulting credit lands on
// differs, handled in WalletService/SupplierWalletService respectively.
enum WalletOwnerType {
  seller
  supplier
}

enum TopUpRequestStatus {
  pending
  verified
  rejected
}

model WalletTopUpRequest {
  id             String             @id @default(uuid()) @db.Uuid
  ownerType      WalletOwnerType    @map("owner_type")
  ownerId        String             @map("owner_id") @db.Uuid
  amount         Decimal            @db.Decimal(12, 2)
  currency       String
  // FR-6.23 - v1.0's one TopUpAdapter implementation is manual bank
  // transfer; the column exists now so a future gateway-based adapter has
  // somewhere to record itself without a schema change.
  method         String             @default("bank_transfer")
  status         TopUpRequestStatus @default(pending)
  // Module 59 (SRS §5.6g, FR-6.33) - set only on a combined signup
  // payment: the portion of `amount`'s sibling total that pays the
  // seller's first billing cycle rather than crediting the wallet.
  // `amount` above keeps its pre-existing meaning (the wallet top-up
  // portion only) so every ordinary top-up request is unaffected - null
  // here is how verifyTopUp() tells an ordinary top-up from a combined one.
  planFeePortion Decimal?           @map("plan_fee_portion") @db.Decimal(12, 2)
  requestedAt    DateTime           @default(now()) @map("requested_at") @db.Timestamptz
  verifiedAt     DateTime?          @map("verified_at") @db.Timestamptz
  verifiedBy     String?            @map("verified_by") @db.Uuid

  verifiedByAdmin AdminUser? @relation(fields: [verifiedBy], references: [id])

  @@index([ownerType, ownerId, status], name: "idx_wallet_topups_owner_status")
  @@map("wallet_topup_requests")
}

// Module 20 (SRS FR-7.10 supplement). A supplier only ever owes its own
// Premium-tier plan fee - no commission, no team seats, no device slots -
// so this is a small, dedicated ledger rather than overloading LedgerEntry
// (a richer, seller-owned entry-type set) with a second, unrelated owner.
// Same balance convention as LedgerEntry: amount always a positive
// magnitude, SupplierWalletService.getBalance() applies the sign.
enum SupplierLedgerEntryType {
  topup_credit
  plan_fee_debit
}

model SupplierWalletEntry {
  id         String                  @id @default(uuid()) @db.Uuid
  supplierId String                  @map("supplier_id") @db.Uuid
  type       SupplierLedgerEntryType
  amount     Decimal                 @db.Decimal(12, 2)
  currency   String
  createdAt  DateTime                @default(now()) @map("created_at") @db.Timestamptz

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt], name: "idx_supplier_wallet_entries_supplier_created")
  @@map("supplier_wallet_entries")
}

// Module 47 (SRS §5.47/FR-47.2, FR-47.3) - Emotional & Retention Layer,
// milestone celebrations only (this scope's build does not include
// FR-47.1's onboarding reframe, FR-47.4's achievement badges, or FR-47.5's
// personalization tie-in). Deliberately its own table rather than reusing
// PlatformEvent: FR-47.3 requires "fires exactly once per store per
// threshold, even under concurrent qualifying orders" - a DB-level
// @@unique constraint on (storeId, metric, threshold) is what actually
// guarantees that under concurrency, not just careful application code.
// Append-only by design, same immutable-history discipline as
// PlatformEvent/AdminAuditLog - no update path exists anywhere in the
// service layer once a row is inserted.
enum MilestoneMetric {
  order_count
  sales_amount
}

model MilestoneEvent {
  id        String          @id @default(uuid()) @db.Uuid
  storeId   String          @map("store_id") @db.Uuid
  metric    MilestoneMetric
  threshold Decimal         @db.Decimal(14, 2)
  reachedAt DateTime        @default(now()) @map("reached_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, metric, threshold])
  @@index([storeId, reachedAt], name: "idx_milestone_events_store_reached")
  @@map("milestone_events")
}

// SRS §5.6k (v0.41) - Subscription Business Readiness re-amended for the
// subscription-only model. Every model below backs one of Modules 65/68/
// 71/90.

// Module 65 (FR-6.42) - admin-editable renewal-reminder/win-back email
// copy. One row per trigger key (e.g. "renewal_reminder_7d",
// "winback_14d"); EmailTemplatesService seeds every key this FR names on
// first read (upsert-if-missing), so a template is never "not found" -
// only ever "still the seeded default."
model EmailTemplate {
  key       String   @id
  subject   String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// Module 90 (FR-8.18) - the minimal support-ticket system Module 68's SLA
// hours are enforced against. Deliberately bare: a ticket is a subject, a
// body, and a thread of plain-text replies - no rich text, attachments,
// multi-department routing, or canned responses (disclosed scope, see
// FR-8.18's own text).
enum TicketStatus {
  open
  resolved
}

model SupportTicket {
  id                   String       @id @default(uuid()) @db.Uuid
  storeId              String       @map("store_id") @db.Uuid
  subject              String
  status               TicketStatus @default(open)
  // Computed once, at creation, from the store's plan's support.sla_hours
  // - never recomputed if the plan later changes, so a ticket's promised
  // response time is fixed the moment it's opened.
  slaDeadline          DateTime     @map("sla_deadline") @db.Timestamptz
  // Set the first time the 80%-of-window sweep fires for this ticket, so
  // it never re-fires the same near-breach notice on every subsequent
  // sweep pass.
  nearBreachNotifiedAt DateTime?    @map("near_breach_notified_at") @db.Timestamptz
  resolvedAt           DateTime?    @map("resolved_at") @db.Timestamptz
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz

  store    Store           @relation(fields: [storeId], references: [id])
  messages TicketMessage[]

  @@index([storeId], name: "idx_support_tickets_store")
  @@index([status, slaDeadline], name: "idx_support_tickets_status_deadline")
  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  // Denormalized from ticket.storeId - same "RLS policies stay single-
  // level, never a join" convention OrderItem/ProductReview/etc. already
  // establish, rather than a two-hop ticket_id -> support_tickets ->
  // store_id RLS policy.
  storeId    String   @map("store_id") @db.Uuid
  // "seller" | "admin" - never a third party; authorId is the seller's
  // userId or the admin's adminUserId depending on authorType.
  authorType String   @map("author_type")
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId], name: "idx_ticket_messages_ticket")
  @@map("ticket_messages")
}

// Module 71 (FR-6.48) - a durable record of a confirmed identity match
// against a prior first-cycle-discount recipient. Append-only (a flag is
// never cleared) - "the flag is durable, not one-time" per FR-6.48's own
// text; a second confirmed cycle for the same identity is checked against
// every existing flag, not just the most recent.
model SubscriptionAbuseFlag {
  id            String   @id @default(uuid()) @db.Uuid
  sellerId      String   @map("seller_id") @db.Uuid
  // "phone" | "device_cluster" | "cnic" | "payment_instrument"
  matchedSignal String   @map("matched_signal")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([sellerId], name: "idx_subscription_abuse_flags_seller")
  @@map("subscription_abuse_flags")
}

// Module 67 (FR-6.44) - the "don't resend the same alert every 6-hourly
// tick" gate, same sticky-flag discipline as every other warning mechanism
// here (dormantWarningSentAt, retentionWarningDay0/7/13SentAt, etc), just
// keyed by provider instead of by seller/store since the alert condition
// is a per-provider aggregate. alertedAt cleared once the rollup recovers
// above threshold, so a future re-degradation alerts again. Global,
// admin-only, no RLS (mirrors EmailTemplate's own precedent).
model PaymentGatewayHealthAlert {
  provider  PaymentGatewayProvider @id
  alertedAt DateTime?              @map("alerted_at") @db.Timestamptz
  updatedAt DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  @@map("payment_gateway_health_alerts")
}
