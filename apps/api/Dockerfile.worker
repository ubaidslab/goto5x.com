# Same base as Dockerfile - see that file's comments. Separate image because
# the worker's CMD differs; sharing the `base`/`build` stages avoids
# duplicating the install/generate/build steps in CI.

FROM node:20-alpine AS base
WORKDIR /repo
RUN corepack enable
# postgresql16-client (matching docker-compose.yml's postgres:16-alpine) -
# needed for `pg_dump` (backups/database-backup.service.ts's automated
# off-box backup sweep, Risk 5/13). Only the worker image runs that job.
RUN apk add --no-cache postgresql16-client
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile || pnpm install
COPY apps/api/prisma apps/api/prisma
WORKDIR /repo/apps/api
RUN pnpm prisma:generate

FROM base AS dev
WORKDIR /repo
COPY apps/api apps/api
WORKDIR /repo/apps/api
CMD ["pnpm", "start:worker"]

FROM base AS build
WORKDIR /repo
COPY apps/api apps/api
WORKDIR /repo/apps/api
RUN pnpm build

# Security P0 (Risk #48, S12) - see apps/api/Dockerfile's identical
# comment. `apk add` must run before `USER node` (package installs need
# root); every COPY after it runs --chown so the node user can actually
# read its own app code.
FROM node:20-alpine AS production
WORKDIR /app
ENV NODE_ENV=production
# See the `base` stage's comment above - pg_dump must be present in this
# final runtime image too, since this (not `base`/`dev`) is what actually
# runs the worker in production.
RUN apk add --no-cache postgresql16-client
COPY --from=build --chown=node:node /repo/apps/api/package.json ./
COPY --from=build --chown=node:node /repo/node_modules /repo/node_modules
COPY --from=build --chown=node:node /repo/apps/api/node_modules ./node_modules
COPY --from=build --chown=node:node /repo/apps/api/dist ./dist
USER node
CMD ["node", "dist/src/worker/worker.main.js"]
