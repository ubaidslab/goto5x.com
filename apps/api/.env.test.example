NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://app_runtime:change-me-local-test-only@localhost:5432/goto5x?schema=public
DATABASE_ADMIN_URL=postgresql://app_admin:change-me-local-test-only@localhost:5432/goto5x?schema=public
TEST_SUPERUSER_DATABASE_URL=postgresql://postgres:change-me-local-test-only@localhost:5432/goto5x?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=test-secret-for-local-dev-only-not-for-production-use-1234567890
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
ADMIN_MFA_ISSUER_NAME=goto5x.com
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=no-reply@goto5x.com
APP_BASE_URL=http://localhost:3001

# Points at the in-process s3rver test double the media/google-drive e2e
# specs start themselves (test/e2e/s3-test-server.ts) - not real MinIO.
# S3RVER/S3RVER are s3rver's own fixed test credentials, not a real secret.
MINIO_ENDPOINT=http://localhost:4569
MINIO_ROOT_USER=S3RVER
MINIO_ROOT_PASSWORD=S3RVER
MINIO_BUCKET=goto5x-media-test
GOOGLE_DRIVE_CLIENT_ID=test-client-id
GOOGLE_DRIVE_CLIENT_SECRET=test-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/media/drive/callback
# Any valid base64-encoded 32-byte value works for tests - generate a real
# one for actual local dev with `openssl rand -base64 32`.
DRIVE_TOKEN_ENCRYPTION_KEY=cVKW5U8XxG2Wn9GxwZ8v4vQY2ZC1o9dCmR3hT5nQmZ4=
