# Copy this file to apps/web/.env.local and fill in real values. Next.js only
# reads .env files from this app's own directory (apps/web/), never the repo
# root - the root .env.example is a separate file for apps/api. Never commit
# the real .env.local (already gitignored).

# The apps/api base URL this Next.js app calls for every live data fetch
# (plans, careers listings, storefront rendering, etc). next.config.js maps
# this into the client-visible NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://localhost:3000

# Comma-separated hostnames (include the port if non-default) that
# middleware.ts treats as the platform's own site; any other Host header is
# routed as a tenant storefront request (Module 4). Must match whatever
# port `next dev`/`next start` actually runs on.
PLATFORM_HOSTNAMES=localhost:3000,app.localhost:3000,app.localhost
