{
  "name": "uzeyn",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @uzeyn/api start:dev",
    "dev:web": "pnpm --filter @uzeyn/web dev",
    "test:api": "pnpm --filter @uzeyn/api test",
    "test:api:e2e": "pnpm --filter @uzeyn/api test:e2e",
    "prisma:migrate": "pnpm --filter @uzeyn/api prisma:migrate",
    "prisma:generate": "pnpm --filter @uzeyn/api prisma:generate",
    "audit": "pnpm audit --audit-level=critical",
    "audit:report": "pnpm audit --audit-level=high || true",
    "verify:dependency-audit-mechanism": "bash scripts/verify-dependency-audit-blocks-vulnerable-package.sh",
    "simulate": "pnpm --filter @uzeyn/api simulate"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "minimist": "^1.2.8"
    }
  }
}
